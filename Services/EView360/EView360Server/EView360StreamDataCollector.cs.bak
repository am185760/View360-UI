        void AlertGenerationOnLicenseThreshold(object state)
        {
            timerLicenseThreshold.Change(-1, -1);
            LogableTask task = LogableTask.NewTask("LicenseThreshold");
            SqlCommand cmd = null;
            string msg = "License Threshold reached.";
            try
            {
                cmd = ConnectionFactory.GetNewCommand(true);
                cmd.CommandText = "select count(*) from atm where is_active=1";
                int utilizedATMCount = Convert.ToInt32(cmd.ExecuteScalar());
                if (100 - ((utilizedATMCount * 100) / LicenseManager.GetLicensedATMs()) <= int.Parse(ConfigurationManager.AppSettings["LicenseThreshold"]))
                    AlertManager.GenerateConditionalGeneralAlert((int)EnumAlertType.Licensing, msg);
            }
            catch (Exception ex)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
            }
            finally
            {
                timerLicenseThreshold.Change(new TimeSpan(0, appSettings.RefreshInterval, 0), new TimeSpan(0, 0, 0, 0, -1));
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Wake up after " + appSettings.RefreshInterval + " min");
                task.EndTask();
                if (cmd != null)
                    if (cmd.Connection != null)
                        cmd.Connection.Close();
            }
        }

        void AlertGenerationOnHardDiskSpaceThreshold(object state)
        {
            timerHardDiskSpaceThreshold.Change(-1, -1);
            LogableTask task = LogableTask.NewTask("HardDiskSpaceThreshold");
            string msg = "Hard Disk Space Threshold reached.";
            try
            {
                ManagementObject disk = new ManagementObject("win32_logicaldisk.deviceid='" + appSettings.LogFilePath.Split('\\')[0] + "'");
                disk.Get();
                if (100 - (Int64.Parse(disk["FreeSpace"].ToString()) * 100 / Int64.Parse(disk["Size"].ToString())) <= int.Parse(ConfigurationManager.AppSettings["HardDiskSpaceThreshold"]))
                    AlertManager.GenerateConditionalGeneralAlert((int)EnumAlertType.HardDiskFreeSpace, msg);
            }
            catch (Exception ex)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
            }
            finally
            {
                timerHardDiskSpaceThreshold.Change(new TimeSpan(0, appSettings.RefreshInterval, 0), new TimeSpan(0, 0, 0, 0, -1));
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Wake up after " + appSettings.RefreshInterval + " min");
                task.EndTask();
            }
        }

        int TraceOrganization(int region_id)
        {
            if (Region.LoadRegionByPk(region_id).IsOrganization == true)
                return region_id;
            else
                return TraceOrganization(Region.LoadRegionByPk(region_id).ParentRegionId.Value);
        }

        void AddAutomaticDownloads(int maxLicensedATMId)
        {
            LogableTask task = LogableTask.NewTask("AddAutomaticDownloads");
            SqlCommand cmd = null;
            DownloadingSchedule.DownloadingScheduleReader schedulesReader = null;

            try
            {
                bool HasRows = false;
                bool scheduleFound = false;
                schedulesReader = DownloadingSchedule.ExecuteReader("1=1");

                while (schedulesReader.Read())
                {
                    HasRows = true;
                    if (DateTime.Now < schedulesReader.CurrentDownloadingSchedule.NextDownloadAt)
                    {
                        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Verbose, "Its not " + schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.ToString()); //   schedulesExecuted++;
                    }
                    else
                    {
                        scheduleFound = true;
                        break;
                    }
                }

                if (!HasRows)
                {
                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Warning, "No schedules time defined");
                    return;
                }

                if (!scheduleFound)
                    return;

                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Verbose, "Its time to schedule download!" + schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.ToString());

                TimeSpan timeSpan = DateTime.Today - schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.AddHours(-schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.Hour)
                    .AddMinutes(-schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.Minute)
                    .AddSeconds(-schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.Second)
                    .AddMilliseconds(-schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.Millisecond);
                schedulesReader.CurrentDownloadingSchedule.NextDownloadAt = schedulesReader.CurrentDownloadingSchedule.NextDownloadAt.AddDays(timeSpan.Days + 1);
                schedulesReader.CurrentDownloadingSchedule.Save();


                cmd = ConnectionFactory.GetNewCommand(true);
                //correct the entires which might be due to killing of service while connecting to an ATM
                cmd.CommandText = " update task set status = 'downloadingDisconnected' where  status = 'initiating' and last_invoked < dateadd(hh, -5, getdate()) and task_type_id = " + (int)EnumTaskType.CashDataDownload;
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, cmd.ExecuteNonQuery() + " atms changed from initiating to downloadingDisconnected");

                cmd.CommandText = @"select s.atm_id, s.file_type_id from atm inner join scheduled_downloads s on s.atm_id = atm.atm_id 
                where atm.is_active = 1 and not exists (select atm_id, file_type_id from task where status in ('scheduled', 'downloadingDisconnected','initiating','downloading','nameReceived','sizeReceived') 
                and atm_id = s.atm_id and file_type_id= s.file_type_id) and s.atm_id <= " + maxLicensedATMId;
                SqlDataReader scheduleReader = cmd.ExecuteReader();
                SqlConnection sqlConn = ConnectionFactory.GetNewConnection();
                sqlConn.Open();
                SqlTransaction sqlTrx = sqlConn.BeginTransaction();

                try
                {
                    //appSettings.LastDownloadedAt = DateTime.Now;
                    //appSettings.Save(sqlConn, sqlTrx);
                    int count = 0;

                    while (scheduleReader.Read())
                    {
                        Task CashDataDownloadTask = new Task();
                        CashDataDownloadTask.ATMId = (int)scheduleReader["atm_id"];
                        CashDataDownloadTask.BytesTransferred = 0;
                        CashDataDownloadTask.CreationTime = DateTime.Now;
                        CashDataDownloadTask.CreatedBy = 1;
                        CashDataDownloadTask.DownloadTime = new DateTime(1900, 1, 1);
                        CashDataDownloadTask.FileTypeId = (int)scheduleReader["file_type_id"];
                        CashDataDownloadTask.Parsed = false;
                        CashDataDownloadTask.RetryRemaining = (byte)appSettings.MaxTries;
                        CashDataDownloadTask.Status = DownloadStates.scheduled.ToString();
                        CashDataDownloadTask.TaskTypeId = (int)EnumTaskType.CashDataDownload;
                        CashDataDownloadTask.DownloadingScheduleId = schedulesReader.CurrentDownloadingSchedule.DownloadingScheduleId;
                        CashDataDownloadTask.Save(sqlConn, sqlTrx);
                        count++;
                    }
                    scheduleReader.Close();
                    sqlTrx.Commit();
                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, count + " files scheduled for downloading");
                }
                catch (Exception ex)
                {
                    sqlTrx.Rollback();
                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
                }
                finally
                {
                    sqlConn.Close();
                }
            }
            catch (Exception ex)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
            }
            finally
            {
                if (schedulesReader != null)
                    schedulesReader.Close();
                if (cmd != null)
                    cmd.Connection.Close();
                task.EndTask();
            }
        }

        void PerformDownloads(int maxLicensedATMId)
        {
            LogableTask task = LogableTask.NewTask("PerformDownloads");
            //int count = 0;
            SqlConnection conn = null;

            try
            {

                conn = ConnectionFactory.GetNewConnection();
                conn.Open();
                SqlCommand cmd = conn.CreateCommand();
                cmd.CommandText = @"select task_id, ip, task.created_by 
                                    from task inner join atm 
                                    on task.atm_id = atm.atm_id 
                                    and atm.is_active = 1 and atm.atm_id <=" + maxLicensedATMId +
                                    " and task_type_id = " + (int)EnumTaskType.CashDataDownload +
                                    " and status in ('downloadingDisconnected','scheduled','nameReceived','sizeReceived') " +
                                     " or (status in ('downloading','resumedDownloading') " +
                                     " and last_invoked < dateadd(hh,-5,getdate())) " +
                                     " and retry_remaining >0 order by task.creation_time";

                SqlDataReader reader = cmd.ExecuteReader();

                //Task.TaskReader taskReader = Task.ExecuteReader(" task_type_id = " + (int)EnumTaskType.CashDataDownload + " and status in ('downloadingDisconnected','scheduled','nameReceived','sizeReceived') or (status in ('downloading','resumedDownloading') and last_invoked < dateadd(hh,-5,getdate())) and retry_remaining >0 order by creation_time");
                while (reader.Read())
                {
                    //      count++;
                    if (ActiveDownloads.Count > (10 * processorCount))
                    {
                        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "taking a minute off");
                        Thread.Sleep(60 * 1000);
                    }
                    Task downloadTask = Task.LoadTaskByPk(reader.GetInt32(0));

                    //if (downloadTask.ATMId > maxLicensedATMId)
                    //{
                    //    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Warning, "ATM id " + downloadTask.ATMId + " is not licensed");
                    //    continue;
                    //}

                    scheduleTerminalIP = reader.GetString(1);

                    if (!TerminalAlreadyConnected(scheduleTerminalIP))
                    {
                        Downloader downloader = new Downloader(downloadTask);
                        downloader.requestInitiatedAT = DateTime.Now;
                        lock (CurrencyMngServer.ActiveDownloads)
                        {
                            ActiveDownloads.Add(downloader);
                        }
                        if (downloader.Start())
                            task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info,
                            string.Format(" going to start download for {0} at {2}, {1} atms in queue ", downloader.ATMIP, ActiveDownloads.Count, downloader.requestInitiatedAT));
                    }
                    else
                    {
                        LogableTask.LogMonoActivityTask("ScheduleDownload", MethodBase.GetCurrentMethod(), TraceLevel.Info,
                        string.Format(" Terminal {0} already connected,job id {1}, created by {2}", scheduleTerminalIP, reader.GetInt32(0), reader.GetInt32(2)));
                    }

                    if (ActiveDownloads.Count > 3)
                        Thread.Sleep(3000); //to avoid boombardment of downloads
                }
                //    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info,"Jobs found"+count);
                reader.Close();
            }
            catch (Exception ex)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
            }
            finally
            {
                task.EndTask();
                if (conn != null)
                    if (conn.State == System.Data.ConnectionState.Open)
                        conn.Close();

            }
        }

        void DoPreProcessingTask()
        {
            
            StringBuilder builder =null;
            if (listAtmStatus.Count > 0)
            {
                builder = new StringBuilder();
                foreach (ATMStatus atmStatus in listAtmStatus)
                    builder.Append(atmStatus.atm_id + ",");

            }
            using (SqlCommand cmd = ConnectionFactory.GetNewCommand(true))
            {
                if (builder != null)
                {
                    cmd.CommandText = "select atm_id, ip from atm where is_active = 1 and atm_id <= " + LicenseManager.MaxLicensedATMID() + " and atm_id not in (" + builder.ToString() + "-1)";
                    
                }
                else
                {
                    cmd.CommandText = "select atm_id, ip from atm where is_active = 1 and atm_id <= " + LicenseManager.MaxLicensedATMID();
                    
                }

                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        ATMStatus atmStatus = new ATMStatus();
                        atmStatus.atm_id = reader.GetInt32(0);
                        atmStatus.ip = reader.GetString(1);
                        atmStatus.lastNotificationAt = new DateTime(1900, 1, 1);
                        lock (listAtmStatus)
                        {
                            listAtmStatus.Add(atmStatus);
                        }
                    }
                }
            }
        }

        bool TerminalAlreadyConnected(string scheduleTerminalIP)
        {
            for (int i = 0; i < ActiveDownloads.Count; i++)
            {
                if (ActiveDownloads[i].ATMIP == scheduleTerminalIP)
                {
                    if (ActiveDownloads[i].requestInitiatedAT < DateTime.Now.AddHours(-6))
                    {
                        try
                        {
                            if (ActiveDownloads[i].currentThread != null && ActiveDownloads[i].currentThread.IsAlive)
                            {
                                ActiveDownloads[i].currentThread.Abort();
                                LogableTask.LogMonoActivityTask("Scheduling", System.Reflection.MethodBase.GetCurrentMethod(), TraceLevel.Verbose, string.Format("Thread aborted for terminal {0}", ActiveDownloads[i].ATMIP));
                            }
                        }
                        catch (Exception ex)
                        {
                            LogableTask.LogMonoActivityTask("Scheduling", System.Reflection.MethodBase.GetCurrentMethod(), TraceLevel.Verbose, string.Format("Exception occured while trying to kill thread for terminal {0}-{1}", ActiveDownloads[i].ATMIP, ex.Message));
                        }

                        lock (CurrencyMngServer.ActiveDownloads)
                        {

                            ActiveDownloads.RemoveAt(i);
                            i--;
                            LogableTask.LogMonoActivityTask("Scheduling", System.Reflection.MethodBase.GetCurrentMethod(), TraceLevel.Verbose, string.Format("Terminal {0} removed because 6 hrs have been elapsed", ActiveDownloads[i].ATMIP));
                        }
                        return false;
                    }
                    else
                        return true;
                }
            }
            return false;
        }
    }
}
