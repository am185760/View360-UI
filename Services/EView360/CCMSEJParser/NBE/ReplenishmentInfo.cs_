        ///<summary>
        ///Edited by Ali Shah on 11Dec2017
        ///#Reference Point 1.0
        ///To handle the case where after SOP counters decreases in After SOP as compare to Before SOP, but actually replenishment occured.
        ///Case 1: Replenishment with less amount
        ///Case 2: Replenishment reflected in Before SOP and Test Cash reflected in After SOP
        /// </summary>

        private bool IsTestCashActivityOnly(AtmCounter newCount, int newRejectCount, AtmCounter oldCount, int oldRejectCount, bool isClearCash)
        {
            bool isTestCash = false;
            int newTotalCount = newCount.Type1 + newCount.Type2 + newCount.Type3 + newCount.Type4;
            int oldTotalCount = oldCount.Type1 + oldCount.Type2 + oldCount.Type3 + oldCount.Type4;


            //newTotalCount += newRejectCount;
            //oldTotalCount += oldRejectCount;
            isTestCash = ((newTotalCount + newRejectCount) == (oldTotalCount + oldRejectCount));
            ///<Summary>
            ///Edited by Ali Shah on 2nd July, 2016
            ///To deal some exceptional cases
            if (!isTestCash)
                //isTestCash = (newTotalCount <= oldTotalCount);
                isTestCash = (newTotalCount <= oldTotalCount && !isClearCash);


            return isTestCash;
        }

