        public void ParseAndSaveReplenishment(ref string ejData, Task downloadTask, LogableTask task, SqlTransaction trxn)
        {
            SqlCommand cmd = null;
            try
            {
                globalTask = downloadTask;
                Atm atm = Atm.LoadAtmByPk(downloadTask.ATMId);
                if (atm.AtmType.ToLower().Contains("ncr"))
                {
                    ExtractAllNCRReplenishments(ref ejData, downloadTask, task, trxn);
                }
                else
                {
                    bool isSwap = true; //Always will be true in Qatar case. As per Talha, Clear Cash is must before each Replenishment.

                    //Variable added by Ali Shah on 3rd June, 2016
                    //To make sure that replenishment has been found then ExtractCashCount function would be executed
                    bool isRepFound = false;

                    cmd = ConnectionFactory.GetNewCommand(true);
                    match = regex.Match(ejData);

                    EjParsedReplenishments cashAdded;
                    Replenishment lastSavedReplenishment = null;
                    ///<Summary>
                    ///Edited by Ali Shah on 1st July, 2016
                    cashAddedDate = DateTime.Today.ToString("dd/MM/yyyy");

                    taskId = downloadTask.TaskId;

                    ///<Summary>
                    ///Added by Ali Shah on 28th May, 2017
                    ///To handle Alerts when replenishment occurred.
                    bool isOutOfCashAlertGenerated = false;
                    bool isOutOfCashAlertResolved = false;
                    bool isLowBalanceAlertResolved = false;
                    bool isLowBalanceAlertGenerated = false;

                    //Commented by Ali Shah on 19th March, 2017.
                    LogableTask.LogMonoActivityTask("ExtractRep", MethodBase.GetCurrentMethod(), TraceLevel.Info, "Going to match SOP Chunks for task: " + downloadTask.TaskId);
                    while (match.Success)
                    {

                        /////Edited by Ali Shah on 26thFeb2017
                        /////Issue occurred when there were three cassette's counters were available instead of four in BBQ.
                        //newCountNotes = new AtmCounter();

                        //Commented by Ali Shah on 19th March, 2017.
                        LogableTask.LogMonoActivityTask("ExtractRep", MethodBase.GetCurrentMethod(), TraceLevel.Info, "Match Succeeded for SOP Chunks for task: " + downloadTask.TaskId);

                        if (this.match.Groups["CountsClearingTime"].Success)
                        {
                            isSwap = true;
                            // this.match = this.match.NextMatch();
                        }

                        else
                        {
                            //if (this.match.Groups["CashAddedDate"].Success)
                            //{
                            //    cashAddedDate = this.match.Groups["CashAddedDate"].Value;
                            //}
                            if (this.match.Groups["CashAddedTime"].Success)
                            {
                                //Commented by Ali Shah on 19th March, 2017.
                                LogableTask.LogMonoActivityTask("ExtractRep", MethodBase.GetCurrentMethod(), TraceLevel.Info, "CashAddedTime token found for task: " + downloadTask.TaskId);

                                isRepFound = true;
                                string piece = ejData.Substring(0, match.Index + 350);
                                int datelastIndex = piece.LastIndexOf("DATE");
                                cashAddedDate = piece.Substring(datelastIndex + 7, 14).Replace(" ", "");
                                //int machineKeywordIndex = piece.LastIndexOf("MACHINE NO");CASH COUNTERS
                                int machineKeywordIndex = piece.LastIndexOf("CASH COUNTERS");
                                //int serviceKeywordIndex = piece.LastIndexOf("SERVICEMODE LEFT");
                                string piece2 = string.Empty;
                                if (machineKeywordIndex > 2000)
                                {
                                    piece2 = ejData.Substring(machineKeywordIndex - 2000, 2200);
                                }
                                //bool MatchCashClear = piece2.Contains("CLEAR CASH");
                                //startMatch = StartRepRegex.Match(piece2);

                                oldRejectCount = match.Groups["NewRejectCount"].Success ? int.Parse(match.Groups["NewRejectCount"].Value) : 0;

                                if (oldRejectCount < 10)
                                {
                                    isSwap = true;
                                }
                                else
                                {
                                    isSwap = false;
                                }
                                if (machineKeywordIndex < 0)
                                {
                                    LogableTask.LogMonoActivityTask("ExtractRep", MethodBase.GetCurrentMethod(), TraceLevel.Info, "Cash counters not found to extract replenishment for taskID:" + downloadTask.TaskId);
                                    match = match.NextMatch();
                                    continue;
                                }
                                Match matchCounters = NCRRegex.Match(piece.Substring(machineKeywordIndex));

                                ///<Summary>
                                ///Edited by Ali Shah on 13th Feb, 2017
                                ///matchCounters were not matched and that made the file to 'failed to parse'
                                ///Change for HDB
                                int SOPKeywordIndex = piece.LastIndexOf("CASH COUNTERS BEFORE SOP");
                                if (SOPKeywordIndex < 1)
                                {
                                    if (!matchCounters.Success)
                                    {
                                        LogableTask.LogMonoActivityTask("ExtractRep", MethodBase.GetCurrentMethod(), TraceLevel.Warning, "Cash counters not matched to extract replenishment for taskID:" + downloadTask.TaskId);
                                        match = match.NextMatch();
                                        continue;
                                    }
                                }


                                notesUsedInTestCash = new AtmCounter();
                                notesAvailable = new AtmCounter();
                                notesDenomination = new AtmCounter();

                                //if(matchCounters.Groups["Cassette1"].Success)
                                //    notesAfterRepType1 = int.Parse(matchCounters.Groups["Cassette1"].Value);
                                //if(matchCounters.Groups["Cassette2"].Success)
                                //    notesAfterRepType2 = int.Parse(matchCounters.Groups["Cassette2"].Value);
                                //if(matchCounters.Groups["Cassette3"].Success)
                                //    notesAfterRepType3 = int.Parse(matchCounters.Groups["Cassette3"].Value);
                                //if(matchCounters.Groups["Cassette4"].Success)
                                //    notesAfterRepType4 = int.Parse(matchCounters.Groups["Cassette4"].Value);

                                ///<Summary>
                                ///
                                if (matchCounters.Groups["CashAddedDate"].Success)
                                    cashAddedDate = matchCounters.Groups["CashAddedDate"].Value;
                                ///<Summary>
                                ///Added by Ali Shah on 3rd June, 2016
                                //Extracting Notes Count just after Replenishment to get correct Replenishment
                                if (matchCounters.Groups["Remaining1"].Success)
                                    notesAfterRepType1 = int.Parse(matchCounters.Groups["Remaining1"].Value);
                                if (matchCounters.Groups["Remaining2"].Success)
                                    notesAfterRepType2 = int.Parse(matchCounters.Groups["Remaining2"].Value);
                                if (matchCounters.Groups["Remaining3"].Success)
                                    notesAfterRepType3 = int.Parse(matchCounters.Groups["Remaining3"].Value);
                                if (matchCounters.Groups["Remaining4"].Success)
                                    notesAfterRepType4 = int.Parse(matchCounters.Groups["Remaining4"].Value);

                                #region NewCountAssignment

                                //newCountNotes.Type1 = match.Groups["NewCountType1"].Success ? int.Parse(match.Groups["NewCountType1"].Value) : 0;
                                //newCountNotes.Type2 = match.Groups["NewCountType2"].Success ? int.Parse(match.Groups["NewCountType2"].Value) : 0;
                                //newCountNotes.Type3 = match.Groups["NewCountType3"].Success ? int.Parse(match.Groups["NewCountType3"].Value) : 0;
                                //newCountNotes.Type4 = match.Groups["NewCountType4"].Success ? int.Parse(match.Groups["NewCountType4"].Value) : 0;
                                //Extracting Notes Count just after Replenishment to get correct Replenishment
                                //Calling changed to improve these object's utilization and to avoid calling through match again and again.
                                //if (match.Groups["NewCountType1"].Success)
                                //    notesAvailable.Type1 = int.Parse(match.Groups["NewCountType1"].Value);
                                //if (match.Groups["NewCountType2"].Success)
                                //    notesAvailable.Type2 = int.Parse(match.Groups["NewCountType2"].Value);
                                //if (match.Groups["NewCountType3"].Success)
                                //    notesAvailable.Type3 = int.Parse(match.Groups["NewCountType3"].Value);
                                //if (match.Groups["NewCountType4"].Success)
                                //    notesAvailable.Type4 = int.Parse(match.Groups["NewCountType4"].Value);
                                //if (match.Groups["NewCountType5"].Success)
                                //    notesAvailable.Type5 = int.Parse(match.Groups["NewCountType5"].Value);

                                #endregion
                                ///<Summary>
                                ///Added by Ali Shah on 6th June, 2016
                                //Extracting Notes Count just after Replenishment to get correct Replenishment
                                if (matchCounters.Groups["Rejected1"].Success && int.Parse(matchCounters.Groups["Rejected1"].Value) > 0)
                                    notesUsedInTestCash.Type1 = int.Parse(matchCounters.Groups["Rejected1"].Value);
                                else
                                    //notesUsedInTestCash.Type1 = int.Parse(matchCounters.Groups["Remaining1"].Value) - int.Parse(match.Groups["NewCountType1"].Value);
                                    notesUsedInTestCash.Type1 = int.Parse(!String.IsNullOrEmpty(matchCounters.Groups["Remaining1"].Value) ? matchCounters.Groups["Remaining1"].Value : "0") - notesAvailable.Type1;

                                if (matchCounters.Groups["Rejected2"].Success && int.Parse(matchCounters.Groups["Rejected2"].Value) > 0)
                                    notesUsedInTestCash.Type2 = int.Parse(matchCounters.Groups["Rejected2"].Value);
                                else
                                    //notesUsedInTestCash.Type2 = int.Parse(matchCounters.Groups["Remaining2"].Value) - int.Parse(match.Groups["NewCountType2"].Value);
                                    notesUsedInTestCash.Type2 = int.Parse(!String.IsNullOrEmpty(matchCounters.Groups["Remaining2"].Value) ? matchCounters.Groups["Remaining2"].Value : "0") - notesAvailable.Type2;

                                if (matchCounters.Groups["Rejected3"].Success && int.Parse(matchCounters.Groups["Rejected3"].Value) > 0)
                                    notesUsedInTestCash.Type3 = int.Parse(matchCounters.Groups["Rejected3"].Value);
                                else
                                    //notesUsedInTestCash.Type3 = int.Parse(matchCounters.Groups["Remaining3"].Value) - int.Parse(match.Groups["NewCountType3"].Value);
                                    notesUsedInTestCash.Type3 = int.Parse(!String.IsNullOrEmpty(matchCounters.Groups["Remaining3"].Value) ? matchCounters.Groups["Remaining3"].Value : "0") - notesAvailable.Type3;

                                if (matchCounters.Groups["Rejected4"].Success && int.Parse(matchCounters.Groups["Rejected4"].Value) > 0)
                                    notesUsedInTestCash.Type4 = int.Parse(matchCounters.Groups["Rejected4"].Value);
                                else
                                    //notesUsedInTestCash.Type4 = int.Parse(matchCounters.Groups["Remaining4"].Value) - int.Parse(match.Groups["NewCountType4"].Value);
                                    notesUsedInTestCash.Type4 = int.Parse(!String.IsNullOrEmpty(matchCounters.Groups["Remaining4"].Value) ? matchCounters.Groups["Remaining4"].Value : "0") - notesAvailable.Type4;


                                ///<Summary>
                                ///Added by Ali Shah on 6th June, 2016
                                ////Extracting Notes Count just after Replenishment to get correct Replenishment
                                ///
                                //// open for HDB
                                //if (match.Groups["NewCountType1"].Success)
                                //    notesAvailable.Type1 = int.Parse(match.Groups["NewCountType1"].Value);
                                //if (match.Groups["NewCountType2"].Success)
                                //    notesAvailable.Type2 = int.Parse(match.Groups["NewCountType2"].Value);
                                //if (match.Groups["NewCountType3"].Success)
                                //    notesAvailable.Type3 = int.Parse(match.Groups["NewCountType3"].Value);
                                //if (match.Groups["NewCountType4"].Success)
                                //    notesAvailable.Type4 = int.Parse(match.Groups["NewCountType4"].Value);
                                //if (match.Groups["NewCountType5"].Success)
                                //    notesAvailable.Type5 = int.Parse(match.Groups["NewCountType5"].Value);

                                ///<Summary>
                                ///Added by Ali Shah on 6th June, 2016
                                //Extracting Denomination to calculate amount of test cash
                                //Changes for HDB
                                //if (match.Groups["DenominationType5"].Success)
                                //{
                                //    if (match.Groups["DenominationType1"].Success)
                                //        notesDenomination.Type4 = int.Parse(match.Groups["DenominationType1"].Value);
                                //    if (match.Groups["DenominationType2"].Success)
                                //        notesDenomination.Type4 = int.Parse(match.Groups["DenominationType2"].Value);
                                //    if (match.Groups["DenominationType3"].Success)
                                //        notesDenomination.Type3 = int.Parse(match.Groups["DenominationType3"].Value);
                                //    if (match.Groups["DenominationType4"].Success)
                                //        notesDenomination.Type2 = int.Parse(match.Groups["DenominationType4"].Value);
                                //    if (match.Groups["DenominationType5"].Success)
                                //        notesDenomination.Type1 = int.Parse(match.Groups["DenominationType5"].Value);
                                //}
                                //else
                                //{
                                //    if (match.Groups["DenominationType1"].Success)
                                //        notesDenomination.Type4 = int.Parse(match.Groups["DenominationType1"].Value);
                                //    if (match.Groups["DenominationType2"].Success)
                                //        notesDenomination.Type3 = int.Parse(match.Groups["DenominationType2"].Value);
                                //    if (match.Groups["DenominationType3"].Success)
                                //        notesDenomination.Type2 = int.Parse(match.Groups["DenominationType3"].Value);
                                //    if (match.Groups["DenominationType4"].Success)
                                //        notesDenomination.Type1 = int.Parse(match.Groups["DenominationType4"].Value);

                                //}


                                ///<Summary>
                                ///Changed the location of below two lines
                                ///Changed by Ali Shah n 2nd June, 2016
                                ///There is a need to record Reject Count in ExtractCashAdd function.
                                newRejectCount = match.Groups["NewRejectCount"].Success ? int.Parse(match.Groups["NewRejectCount"].Value) : 0;
                                oldRejectCount = match.Groups["OldRejectCount"].Success ? int.Parse(match.Groups["OldRejectCount"].Value) : 0;

                                //Edited parameter by Ali Shah on 3rd Feb, 2017
                                //isSwap variable should be pass to update its value when there is a case of Swap replenishment found.
                                //cashAdded = ExtractCashAdd(ejData);
                                cashAdded = ExtractCashAdd(ejData, ref isSwap);
                                cashAdded.TaskId = downloadTask.TaskId;
                                cashAdded.AtmId = downloadTask.ATMId;

                                LogableTask.LogMonoActivityTask("Replenishment Found", MethodBase.GetCurrentMethod(), TraceLevel.Info, "cashAdded.RepDatetime: " + cashAdded.RepDatetime + ", cashAddedTime : " + cashAddedTime + ", task id: " + downloadTask.TaskId);
                                //cmd.CommandText = "isRepCountersExists";
                                cmd.CommandText = "isRepCountersInHourExists";
                                cmd.CommandType = CommandType.StoredProcedure;
                                cmd.Parameters.Clear();
                                cmd.Parameters.Add(new SqlParameter("RepDate", SqlDbType.DateTime));
                                cmd.Parameters[0].Value = cashAdded.RepDatetime;
                                cmd.Parameters.Add(new SqlParameter("atmID", SqlDbType.Int));
                                cmd.Parameters[1].Value = downloadTask.ATMId;
                                cmd.Parameters.Add(new SqlParameter("notes1", SqlDbType.Int));
                                cmd.Parameters[2].Value = cashAdded.NotesAddedType1;
                                cmd.Parameters.Add(new SqlParameter("notes2", SqlDbType.Int));
                                cmd.Parameters[3].Value = cashAdded.NotesAddedType2;
                                cmd.Parameters.Add(new SqlParameter("notes3", SqlDbType.Int));
                                cmd.Parameters[4].Value = cashAdded.NotesAddedType3;
                                cmd.Parameters.Add(new SqlParameter("notes4", SqlDbType.Int));
                                cmd.Parameters[5].Value = cashAdded.NotesAddedType4;



                                if ((int)cmd.ExecuteScalar() > 0)
                                {
                                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Transaction  " + ejData.Substring(match.Index, match.Length) + ".because this already exists in ej_parsed_replenishment table. For Task Id: " + downloadTask.TaskId);
                                    match = match.NextMatch();
                                    //isSwap = false;
                                    isRepFound = false;
                                    continue;
                                }

                                //if (cashAdded.NotesAddedType1 == 0 && cashAdded.NotesAddedType2 == 0 && cashAdded.NotesAddedType3 == 0 && cashAdded.NotesAddedType4 == 0)
                                //{
                                //    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Transaction  " + ejData.Substring(match.Index, match.Length) + ".becauseall counters are 0.");
                                //    match = match.NextMatch();
                                //    //isSwap = false;
                                //    isRepFound = false;
                                //    continue;
                                //}

                                //Function call added by Ali Shah on 6th June, 2016
                                //To insert Test Cash as Transaction
                                EjParsedTransactions trans = EjParsedTransactions.LoadEjParsedTransactions("ATM_id = " + downloadTask.ATMId + " and trxn_datetime = Convert(datetime,'" + Convert.ToDateTime(cashAdded.RepDatetime).ToString("dd/MM/yyyy HH:mm:ss") + "',103)");
                                if (trans != null)  //Case if test cash transaction already inserted at same time
                                {
                                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Test Cash Transaction " + ejData.Substring(match.Index, match.Length) + " as it already exist.");
                                    match = match.NextMatch();
                                    continue;
                                }

                                ///Edited by Ali Shah on 19July2020
                                ///#Reference Point 1.0
                                ///
                                string ejChunk = ejData.Substring(0, match.Index);
                                int indxReplenishmentStart = ejChunk.LastIndexOf("SERVICEMODE ENTERED");
                                string repChunk = indxReplenishmentStart > 0 ? ejChunk.Substring(indxReplenishmentStart) : ejChunk.Substring(0);
                                if (SOPKeywordIndex < 1)
                                {
                                    matchClearCash = rgxClearCash.Match(repChunk);

                                    //Edited by Ali Shah on 10th June, 2016
                                    //To correct the calculation of Test Cash

                                    //bool isTestCashActivityOnly = IsTestCashActivityOnly(remainingCount, newRejectCount, prevCount, oldRejectCount);
                                    ///Edited by Ali Faiyaz Shah on 19th July, 2020
                                    ///Taking into considertation for Qatar, No Clear Cash means No Replenishment as per Talha Recommendation.
                                    bool isTestCashActivityOnly = false;
                                    if (!matchClearCash.Success)
                                    {
                                        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring as Replenishment, in Qatar, Clear Cash must be done before Replenishment");
                                        isTestCashActivityOnly = true;
                                    }
                                    else
                                        isTestCashActivityOnly = false; // IsTestCashActivityOnly(remainingCount, newRejectCount, prevCount, oldRejectCount, matchClearCash.Success);

                                    if (isTestCashActivityOnly)
                                    {
                                        //Commented by Ali Shah on 19th March, 2017.
                                        LogableTask.LogMonoActivityTask("TestCash Activity Only", MethodBase.GetCurrentMethod(), TraceLevel.Info, "This is test cash activity only for task: " + downloadTask.TaskId);
                                        int totalTestCash = newRejectCount - oldRejectCount;
                                        int[,] arrayBeforeChunk = new int[4, 3];
                                        int[,] arrayAfterChunk = new int[4, 3];
                                        //enum columnName {Denomination, Counters , IsProcessed };
                                        if (totalTestCash > 0)
                                        {
                                            int i = 0;
                                            //int j = 0;
                                            PopulateArrayThroughCounterObject(ref arrayBeforeChunk, notesDenomination, prevCount);
                                            PopulateArrayThroughCounterObject(ref arrayAfterChunk, notesDenomination, notesAvailable);
                                            while (i < 4)
                                            {
                                                for (int j = 0; j < 4; j++)
                                                {
                                                    if (arrayBeforeChunk[i, 0] == arrayAfterChunk[j, 0] && (Math.Abs(arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1]) <= totalTestCash) && arrayAfterChunk[j, 2] == 0)
                                                    {
                                                        totalTestCash -= arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1];
                                                        arrayAfterChunk[j, 2] = 1;
                                                        switch (i)
                                                        {
                                                            case 0:
                                                                notesUsedInTestCash.Type1 = arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1];
                                                                break;
                                                            case 1:
                                                                notesUsedInTestCash.Type2 = arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1];
                                                                break;
                                                            case 2:
                                                                notesUsedInTestCash.Type3 = arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1];
                                                                break;
                                                            case 3:
                                                                notesUsedInTestCash.Type4 = arrayBeforeChunk[i, 1] - arrayAfterChunk[j, 1];
                                                                break;
                                                            default:
                                                                break;
                                                        }
                                                        break;
                                                    }
                                                    //else
                                                    //    continue;

                                                }
                                                i++;
                                            }
                                        }
                                    }
                                    decimal amount = CalculateAmount(notesUsedInTestCash, notesDenomination);
                                    InsertTestCashAsTransaction(cashAdded, amount, notesUsedInTestCash, downloadTask, notesAvailable, task, trxn);

                                    //int newRejectCount = match.Groups["NewRejectCount"].Success ? int.Parse(match.Groups["NewRejectCount"].Value) : 0;
                                    //int oldRejectCount = match.Groups["OldRejectCount"].Success ? int.Parse(match.Groups["OldRejectCount"].Value) : 0;
                                    //if (IsTestCashActivityOnly(remainingCount, newRejectCount, prevCount, oldRejectCount))

                                    if (isTestCashActivityOnly) //Till here
                                    {
                                        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Replenishment: " + ejData.Substring(match.Index, match.Length) + " because this is not replenishment. It is just Test Cash. For Task Id: " + downloadTask.TaskId);
                                        match = match.NextMatch();
                                        isRepFound = false;
                                        continue;
                                    }
                                }
                                ///<Summary>
                                ///Sequence of calling this chunk changed on 14th Feb, 2017.
                                ///There were test cash activity only performed and below chunk were executing as cash added were zero, before test cash entry as transaction.
                                if (cashAdded.NotesAddedType1 == 0 && cashAdded.NotesAddedType2 == 0 && cashAdded.NotesAddedType3 == 0 && cashAdded.NotesAddedType4 == 0)
                                {
                                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Replenishment: " + ejData.Substring(match.Index, match.Length) + " because all counters are 0. For Task Id: " + downloadTask.TaskId);
                                    match = match.NextMatch();
                                    //isSwap = false;
                                    isRepFound = false;
                                    continue;
                                }
                                //Commented by Ali Shah on 19th March, 2017.
                                LogableTask.LogMonoActivityTask("Replenishment Extracted", MethodBase.GetCurrentMethod(), TraceLevel.Info, "Replenishment going to save for Task Id: " + downloadTask.TaskId + " and Replenishment time : " + cashAdded.RepDatetime.ToString());
                                cashAdded.Save(trxn.Connection, trxn);

                                cmd.CommandText = "isReplenishmentSameInHour";
                                cmd.CommandType = CommandType.StoredProcedure;
                                cmd.Parameters.Clear();
                                cmd.Parameters.Add(new SqlParameter("RepDate", SqlDbType.DateTime));
                                cmd.Parameters[0].Value = cashAdded.RepDatetime;
                                cmd.Parameters.Add(new SqlParameter("atmID", SqlDbType.Int));
                                cmd.Parameters[1].Value = downloadTask.ATMId;
                                cmd.Parameters.Add(new SqlParameter("notes1", SqlDbType.Int));
                                cmd.Parameters[2].Value = cashAdded.NotesAddedType1;
                                cmd.Parameters.Add(new SqlParameter("notes2", SqlDbType.Int));
                                cmd.Parameters[3].Value = cashAdded.NotesAddedType2;
                                cmd.Parameters.Add(new SqlParameter("notes3", SqlDbType.Int));
                                cmd.Parameters[4].Value = cashAdded.NotesAddedType3;
                                cmd.Parameters.Add(new SqlParameter("notes4", SqlDbType.Int));
                                cmd.Parameters[5].Value = cashAdded.NotesAddedType4;



                                if ((int)cmd.ExecuteScalar() > 0)
                                {
                                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Replenishment already extracted from counters so ignoring it for atm " + cashAdded.AtmId + " for the date " + cashAdded.RepDatetime + " for Task Id: " + downloadTask.TaskId);
                                    match = match.NextMatch();
                                    //isSwap = false;
                                    isRepFound = false;
                                    continue;
                                }
                                else
                                {
                                    lastSavedReplenishment = this.AddReplenishmentInCCMS(ref downloadTask, ref cashAdded, ref trxn, ref isSwap);
                                    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Extracting replenishment " + this.match.ToString() + " for Task Id: " + downloadTask.TaskId);
                                }
                                //Replenishment replenishment = Replenishment.LoadReplenishment(string.Concat(new object[] { "atm_id = ", downloadTask.ATMId, " and rep_datetime>=convert(datetime,'", cashAdded.RepDatetime.Value.ToString("dd/MM/yyyy"), "',103)  and rep_datetime<=convert(datetime,'", cashAdded.RepDatetime.Value.ToString("dd/MM/yyyy"), " 23:59:59',103) " }));

                                //if (replenishment == null) // This means Replenishment not inserted by EJ & Counters also so insert it
                                //{
                                //    lastSavedReplenishment = this.AddReplenishmentInCCMS(ref downloadTask, ref cashAdded, ref trxn, ref isSwap);
                                //    task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Extracting replenishment " + this.match.ToString() + " for Task Id: " + downloadTask.TaskId);
                                //    //Added on 05/02/2015
                                //    isSwap = false;
                                //}
                                //else
                                //{

                                //    if (replenishment.Reason != null)
                                //    {
                                //        //If it's extracted from EJ then update it.
                                //        if (isSwap)
                                //        {
                                //            replenishment.CashAdded1 = cashAdded.NotesAddedType1.Value;
                                //            replenishment.CashAdded2 = cashAdded.NotesAddedType2.Value;
                                //            replenishment.CashAdded3 = cashAdded.NotesAddedType3.Value;
                                //            replenishment.CashAdded4 = cashAdded.NotesAddedType4.Value;

                                //        }
                                //        else
                                //        {
                                //            replenishment.CashAdded1 += cashAdded.NotesAddedType1.Value;
                                //            replenishment.CashAdded2 += cashAdded.NotesAddedType2.Value;
                                //            replenishment.CashAdded3 += cashAdded.NotesAddedType3.Value;
                                //            replenishment.CashAdded4 += cashAdded.NotesAddedType4.Value;

                                //        }
                                //        replenishment.IsSwap = isSwap;
                                //        replenishment.Save(trxn.Connection, trxn);
                                //        lastSavedReplenishment = replenishment;
                                //        isSwap = false;
                                //    }
                                //    else
                                //    {
                                //        //If Replenishment is extracted from counter file do not update it
                                //        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Replenishment already extracted from counters so ignoring it for atm " + replenishment.AtmId + " for the date " + replenishment.RepDatetime + " for Task Id: " + downloadTask.TaskId);
                                //    }
                                //}
                            }
                        }

                        if (isRepFound)
                        {
                            EjNotesDispensed cashCountClear;

                            cashCountClear = ExtractCashCounts();

                            cmd.CommandText = "isEjClearingCounterExists";
                            cmd.CommandType = CommandType.StoredProcedure;
                            cmd.Parameters.Clear();
                            cmd.Parameters.Add(new SqlParameter("DisDate", SqlDbType.DateTime));
                            cmd.Parameters[0].Value = cashCountClear.ClearingDatetime;
                            cmd.Parameters.Add(new SqlParameter("atmID", SqlDbType.Int));
                            cmd.Parameters[1].Value = downloadTask.ATMId;

                            if ((int)cmd.ExecuteScalar() > 0)
                            {
                                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Info, "Ignoring Dispension:  " + ejData.Substring(match.Index, match.Length) + ".because this already exists in dispensed table.");
                                match = match.NextMatch();
                                continue;
                            }

                            cashCountClear.TaskId = downloadTask.TaskId;
                            cashCountClear.AtmId = downloadTask.ATMId;
                            cashCountClear.Save(trxn.Connection, trxn);

                            /// Added by Ali Shah on 08th Feb, 2017
                            /// To update cash position just after replenishment, before it was updating 
                            /// when first withdrawal transaction occurs after replenishment
                            //UpdateCashPositionAfterReplenishment(cashCountClear, downloadTask.TaskId, task, trxn, ref isOutOfCashAlertResolved, ref isLowBalanceAlertResolved, ref isOutOfCashAlertGenerated, ref isLowBalanceAlertGenerated);
                            //    
                            isRepFound = false;
                        }

                        match = match.NextMatch();
                    }

                    ///<Summary>
                    ///Added by Ali Shah
                    ///Extract those Replenishments who dont have SOP Chunk for Wincor machines
                    try
                    {
                        ExtractAllWincorReplenishments(ref ejData, downloadTask, task, trxn);
                    }
                    catch (Exception ex)
                    {
                        task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
                    }


                }
            }
            catch (Exception e)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, e);
            }

            finally
            {
                if (cmd != null)
                    if (cmd.Connection != null)
                        cmd.Connection.Close();
            }
        }



        private void InsertTestCashAsTransaction(EjParsedReplenishments cashAdded, decimal amount, AtmCounter notesDispensed, Task downloadTask, AtmCounter notesRemaining, LogableTask task, SqlTransaction dbTrxn)
        {
            EjParsedTransactions parsedTrxn = null;
            try
            {
                parsedTrxn = new EjParsedTransactions();
                parsedTrxn.TrxnDatetime = cashAdded.RepDatetime;
                parsedTrxn.Amount = amount;
                parsedTrxn.NotesDispensedType1 = notesDispensed.Type1;
                parsedTrxn.NotesDispensedType2 = notesDispensed.Type2;
                parsedTrxn.NotesDispensedType3 = notesDispensed.Type3;
                parsedTrxn.NotesDispensedType4 = notesDispensed.Type4;

                parsedTrxn.AtmId = downloadTask.ATMId;
                parsedTrxn.TaskId = downloadTask.TaskId;
                parsedTrxn.TransactionTypeId = CommentSaver.GetTransactionTypeId("TestCash");
                parsedTrxn.ProcessingDatetime = DateTime.Now;
                parsedTrxn.StartIndex = cashAdded.StartIndex;
                parsedTrxn.EndIndex = cashAdded.EndIndex;
                parsedTrxn.Status = 0;
                parsedTrxn.NotesRemainingType1 = notesAvailable.Type1;
                parsedTrxn.NotesRemainingType2 = notesAvailable.Type2;
                parsedTrxn.NotesRemainingType3 = notesAvailable.Type3;
                parsedTrxn.NotesRemainingType4 = notesAvailable.Type4;

                parsedTrxn.Save(dbTrxn.Connection, dbTrxn);
            }
            catch (Exception ex)
            {
                task.Log(MethodBase.GetCurrentMethod(), TraceLevel.Error, ex);
            }
        }

        private decimal CalculateAmount(AtmCounter notesDispensed, AtmCounter denomination)
        {
            decimal amount = 0;
            amount = (notesDispensed.Type1 * denomination.Type1) + (notesDispensed.Type2 * denomination.Type2) + (notesDispensed.Type3 * denomination.Type3) + (notesDispensed.Type4 * denomination.Type4);
            return amount;
        }

