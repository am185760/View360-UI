    public async Task NavigateToWindow(string url)
    {
        string baseurl = $"{NavigationManager.BaseUri}{url}";
        await jsRuntime.InvokeVoidAsync("open", baseurl, "_blank", "location=yes,height=1000,width=5000,scrollbars=yes,status=yes");
    }

    private void HandleClick(string pageName)
    {
        NavigationManager.NavigateTo($"{NavigationManager.BaseUri}/EmptyPage");
        NavigationManager.NavigateTo(pageName, false);
    }

    public async Task OpenDashboard(string url)
    {
        List<string> atmIDs = new();
        List<string> regionIDs = new();
        string filter = string.Empty;

        string baseurl = $"{NavigationManager.BaseUri}{url}";
        (atmIDs, regionIDs) = await atmRepository.GetSelectedAtmOrRegionList();
        if (regionIDs?.Count > 0)
        {
            filter = "(" + string.Join(",", regionIDs) + ")";
            baseurl += $"/true/{filter}";
        }
        else
        {
            filter = "(" + string.Join(",", atmIDs) + ")";
            baseurl += $"/false/{filter}";
        }
        await jsRuntime.InvokeVoidAsync("open", baseurl, "_blank", "location=yes,height=1000,width=5000,scrollbars=yes,status=yes");
    }

