    [JSInvokable]
    public async Task Logout()
    {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsLoggedOut();
        atmRepository.ClearAtmSessionValues();
        NavigationManager.NavigateTo("");
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            objRef = DotNetObjectReference.Create(this);
            await jsRuntime.InvokeVoidAsync("initializeInactivityTimer", objRef);
            appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
            var permissions = await localStorage.GetItemAsync<Dictionary<int, string>>("userRights");
            if (permissions is not null)
            {
                userRight = permissions;
            }

            rights = await userService.GetRightsByType();
            adminPermission = CheckAdminViewPermission();
            operationPermission = CheckOperationViewPermission();
            reportPermission = CheckReportViewPermission();
            archivePermission = CheckArchiveViewPermission();
            analyticPermission = CheckPermission((int)Permissions.ViewGraphList);
            InitializePageList();
            await this.InvokeAsync(() => this.StateHasChanged());
        }
        catch(Exception ex)
        {
            logger.LogError($"Exception at Index, CheckPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }
    
    private bool CheckPermission(int right)
    {
        try
        {
            if (userRight is not null)
                return userRight.ContainsKey(right);
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, CheckPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private bool CheckAdminViewPermission()
    {
        try
        {
            foreach (int id in userRight.Keys)
            {
                if (rights.AdminRights.Contains(id))
                    return true;
            }
        }
        catch (Exception ex)
