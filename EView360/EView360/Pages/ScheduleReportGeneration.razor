@code {
    private bool isEdit;
    public List<ScheduleReportsViewModel> scheduleReports = new();
    public List<ScheduleReportsViewModel> filterscheduleReports = new();
    public List<string> scheduleList = new();
    public List<int> hourList = new();
    public List<int> minuteList = new();
    public int? hour;
    public int? miniute;
    public bool scheduleTypeId = false;
    public string filterReportName = "";
    public string schedule { get; set; }
    private bool showSpinner = true;
    private bool showGrid = false;
    private bool showModal = false;
    private bool showScheduleTime = false;
    private DataGrid<ScheduleReportsViewModel>? dataGridRef;
    private EditContext? editContext;
    private ScheduleReportsViewModel scheduleReport = new();
    Dictionary<int, string> userRights;
    [Inject] INotificationService NotificationService { get; set; }
    [Inject] IMessageService MessageService { get; set; }

    protected override async void OnInitialized()
    {
        EView360Models.Core.AppUser appUser = await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser");
        ScheduleReportservice.userId = appUser.UserId;
        editContext = new(scheduleReport);
        userRights = await localStorage.GetItemAsync<Dictionary<int, string>>("userRights");
        for (int i = 0; i < 24; i++)
        {
            hourList.Add(i);
        }

        for (int i = 0; i < 60; i++)
        {
            minuteList.Add(i);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (scheduleTypeId == false)
            {
                showScheduleTime = false;
            }
            if (scheduleTypeId == true)
            {
                showScheduleTime = true;
            }
            await this.InvokeAsync(() => this.StateHasChanged());
            if (firstRender)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at ScheduleReportGeneration Page, OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private async Task LoadData()
    {
        showSpinner = true;
        showGrid = false;
        filterscheduleReports = scheduleReports = await ScheduleReportservice.GetScheduleReport();
        showSpinner = false;
        showGrid = true;
        await this.InvokeAsync(() => this.StateHasChanged());

        //if (scheduleReports is null || scheduleReports.Count == 0)
        //{
        //    await NotificationService.Success("No record found", "Succes", (options) =>
        //    {
        //        options.IntervalBeforeClose = 4000;
        //    });
        //}
    }

    async Task OnCustomEditCommand(EditCommandContext<ScheduleReportsViewModel> context)
    {
        isEdit = true;
        string jsonContent = JsonConvert.SerializeObject(context.Item);
        scheduleReport = JsonConvert.DeserializeObject<ScheduleReportsViewModel>(jsonContent)!;
        editContext = new(scheduleReport);
        List<string> scheduleTimeList = new();

        if (scheduleReport.ReportScheduleId > 0)
        {
            var reportGenerations = await ScheduleReportservice.GetScheduleReportGeneration(scheduleReport.ReportScheduleId);

            foreach (var item in reportGenerations)
            {
                scheduleTimeList.Add($"{item.NextGenerationAt.Value.Hour}:{item.NextGenerationAt.Value.Minute}");
            }
            scheduleList = scheduleTimeList;
        }



        if (scheduleReport.ExportType == 1 || scheduleReport.ExportType == 3)
        {
            scheduleReport.ExportPDFChecked = true;
        }
        if (scheduleReport.ExportType == 2 || scheduleReport.ExportType == 3)
        {
            scheduleReport.ExportExcelChecked = true;
        }
        if (scheduleReport.ScheduleType == false)
        {
            scheduleTypeId = false;
            showScheduleTime = false;
        }
        else
        {
            scheduleTypeId = true;
            showScheduleTime = true;
        }

        showModal = true;
        showGrid = false;
        this.InvokeAsync(() => this.StateHasChanged());
    }

    public async Task RenderErrorBox(string title, string message)
    {
        await NotificationService.Error(message, title, (options) =>
        {
            options.IntervalBeforeClose = 4000;
        });
    }

    private void HideModal()
    {
        showModal = false;
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private async Task SubmitHandler()
    {
        try
        {
            isEdit = false;
            showSpinner = true;
            showGrid = false;
            string response = string.Empty;
            HideModal();

            //response = await service.UpdateAlertType(scheduleReport);
            if (response == "error")
            {
                await NotificationService.Error("An error occured while updating schedule reports, check logs..", "Error", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
            }

            //if (response != "error")
            //{
            //    await NotificationService.Success("Changes completed successfully.", "Success", (options) =>
            //    {
            //        options.IntervalBeforeClose = 4000;
            //    });
            //}
            await Task.Delay(300);
            await LoadData();
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at SubmitHandler, SubmitHandler as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }
    private void CloseEditForm()
    {
        showModal = false;
        showGrid = true;
        isEdit = false;
        LoadData();
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private void AddScheduleToList()
    {
        if (miniute != null && hour != null && hour > 0 && miniute > 0)
        {
            string item = hour + ":" + miniute;
            if (!scheduleList.Contains(item))
                scheduleList.Add(item);

            this.InvokeAsync(() => this.StateHasChanged());
        }
    }

    private void RemoveScheduleToList()
    {
        scheduleList.Remove(schedule);
        this.InvokeAsync(() => this.StateHasChanged());
    }


    private async void UpdateReportGeneration()
    {
        scheduleReport.ScheduleType = scheduleTypeId;
        await ScheduleReportservice.UpdateReportGeneration(scheduleReport, scheduleList);
        showModal = false;
        await LoadData();
        await this.InvokeAsync(() => this.StateHasChanged());
    }
    public Task OnCheckedValueChanged(int value)
    {
        if (value == 0)
        {
            showScheduleTime = false;

        }
        else if (value == 1)
        {
            showScheduleTime = true;
        }
        this.InvokeAsync(() => this.StateHasChanged());
        return Task.CompletedTask;
    }

    async Task OnRowRemoved(ScheduleReportsViewModel scheduleReportsView)
    {
        var response = await ScheduleReportservice.DeleteScheduleReport(scheduleReportsView.ReportScheduleId, scheduleReportsView.ReportName);
        if (response == false)
        {
            await NotificationService.Error("an error occured while deleting group, check logs..", "error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }

        await Task.Delay(300);
        await LoadData();
        await this.InvokeAsync(() => this.StateHasChanged());
    }

    async Task OnRowRemoving(CancellableRowChange<ScheduleReportsViewModel> cancellableRow)
    {
        if (await MessageService.Confirm("Are you sure you want to delete ?", "Confirmation", (options) => { options.ConfirmButtonColor = Color.Success; }))
        {
            if (cancellableRow.Item == null)
            {
                cancellableRow.Cancel = true;
                await RenderErrorBox("Error", "Schedule Report not found !");
            }
        }
        else
        {
            cancellableRow.Cancel = true;
        }
    }

    private bool CheckPermission(int right)
    {
        try
        {
            if (userRights is not null)
                return userRights.ContainsKey(right);
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at ScheduleReportGeneration, CheckPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }
    private void FilterSubmit()
    {
        showSpinner = true;
        showGrid = false;
        filterscheduleReports = scheduleReports;
                //group name
        if (!string.IsNullOrEmpty(filterReportName))
        {
            filterscheduleReports = scheduleReports.Where(x => x.ReportName.Trim().ToLower().Contains(filterReportName.Trim().ToLower())).ToList();
        }

        showSpinner = false;
        showGrid = true;

        this.InvokeAsync(() => this.StateHasChanged());
    }

    private void ResetFilter()
    {
        showSpinner = true;
        showGrid = false;

        filterscheduleReports = scheduleReports;
        filterReportName = string.Empty;
        showSpinner = false;
        showGrid = true;

        this.InvokeAsync(() => this.StateHasChanged());
    }

}
