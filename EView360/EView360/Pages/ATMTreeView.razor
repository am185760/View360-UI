@page "/ATMTreeView"
@inject IJSRuntime jsRuntime
@using DataRequestorMiddleware.Services.Admin;
@using EView360.Common;
@using EView360.Services
@using EView360.Data
@using EView360Models.Core;
@using EView360Models.ViewModels;
@using Newtonsoft.Json;
@using static EView360.Common.Constants;

@inject ATMTreeViewRepository atmRepository 
 @inject NotifyService notifyService
@inject NotifyService notifyService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@*@inject Blazored.localStorage.ISessionStorageService sessionStorage
*@
@inject ILogger<ATMTreeView> logger
@implements IDisposable



<div class="container-fluid-tree">
    <div id="the-basics">
        <input class="typeahead form-control" type="text" placeholder="Search..">
    </div>
    <div id="@treeID" class="float-left">
    </div>
    <div class="spinner spinner_tree" style="z-index:4"></div>
</div>

