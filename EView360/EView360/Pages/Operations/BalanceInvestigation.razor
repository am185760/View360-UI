@page "/BalanceInvestigation"
@page "/BalanceInvestigation/{mode}"
@using EView360.Common;
@using EView360.Services.Operations;
@using EView360.Services;
@using global::Common.RequestModel;
@using global::Common.ViewModel;
@using static EView360.Data.Enumerations;
@inject BalanceInvestigationService service
@inject AtmTaskService taskService
@inject ATMTreeViewRepository treeService
@inject NoteSetTypeService noteSetTypeService
@inject ILogger<BalanceInvestigation> logger
@inject NoteSetTypeService noteSetTypeService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ReplenishmentService replanishmentService
@inject YearService yearService
@inject ATMTreeViewRepository atmRepository
@inject NotifyService notifyService
@inject GroupRepository groupService
@implements IDisposable
@inject CommonServices common
@inject IJSRuntime jsRuntime

<div class="row content">
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }
    <div class="col-sm-2 filter_bar border-right-2">
        <form style="margin-top: 20px;">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <h5>Filters: </h5>
                </div>
            </div>
            @if (@mode is not null && mode.Equals("Archive"))
            {
                <div class="form-row">
                    <div class="form-group col-md-12">
                        <label>Archive Year: </label>
                        <Select TValue="int" SelectedValue="@ArchiveYear" class="form-control" SelectedValueChanged="@DateChanged">
                            @foreach (int year in archiveYears)
                            {
                                <SelectItem Value=year>@year</SelectItem>
                            }
                        </Select>
                    </div>
                </div>
            }
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>From Date: </label>

                    @if (@mode is not null && mode.Equals("Archive"))
                    {
                        <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@fromDate" TimeAs24hr="true"></DatePicker>

                    }
                    else
                    {
                        <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@fromDate" TimeAs24hr="true"></DatePicker>
                    }
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>To Date: </label>

                    @if (@mode is not null && mode.Equals("Archive"))
                    {
                        <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@toDate" TimeAs24hr="true"></DatePicker>
                    }
                    else
                    {
                        <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@toDate" TimeAs24hr="true"></DatePicker>
                    }
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    @*<label class="float-left">Group :</label>*@
                    <div>Group:</div>
                    <div>
                        <ListView TItem="NoteSetTypeViewModel"
                                  Data="noteSetType"
                                  TextField="(item) => item.NoteSetTypeName"
                                  ValueField="(item) => item.NoteSetTypeId.ToString()"
                                  Mode="ListGroupMode.Static"
                                  MaxHeight="400px"
                                  Style="margin-top: 2%">
                            <ItemTemplate>
                                <Check TValue="bool" @bind-Checked="context.Item.isSelected">@context.Text</Check>
                            </ItemTemplate>
                        </ListView>
                    </div>
                    @*                    <select @bind="filterNoteSetTypeBy" class="form-control">
                    <option value="*">Any</option>
                    @if (noteSetType != null)
                    {
                    @foreach (var noteSetType in noteSetType?.ToList().Distinct())
                    {
                    <option value="@noteSetType.NoteSetTypeId">@noteSetType.NoteSetTypeName</option>
                    }
                    }
                    </select>*@
                </div>
            </div>

            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@FilterSubmit" value="Search">
            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@ResetFilter" value="Reset">
        </form>
    </div>


    <div class="col-sm-10 text-left" style="margin-top:1%">
        <div class="form-group">
            @if (@mode is not null && mode.Equals("Archive"))
            {
                <b><h2 style="font-family:montserrat; font-weight:bold">Balance Investigation - Archive</h2></b>
            }
            else
            {
                <b><h2 style="font-family:montserrat; font-weight:bold">Balance Investigation</h2></b>
            }
        </div>




        @if (showGrid)
        {
            <DataGrid @ref="@dataGridRef"
                      TItem="BalanceInvestigationViewModel"
                      Data="@filteredBalanceInvestigation"
                      RowStyling="@OnRowStyling"
                            Editable
                       Responsive="true"
                       ShowPager="false"
                            Bordered
                       PageSize="50"
                            FixedHeader
                       FixedHeaderDataGridHeight="500px"
                       FixedHeaderDataGridMaxHeight="500px"
                       Narrow="true"
                            Sortable SortMode="DataGridSortMode.Single"
                       SortChanged="SortData"
                       HeaderThemeContrast="@ThemeContrast.Light">


                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.ATM)" Caption="ATM" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.AtmIp)" Caption="IP" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.AtmLocation)" Caption="Location" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.TxrnDateTime)" Caption="DateTime" DisplayFormat="{0:dd/MM/yyyy hh:mm:ss}" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.OperationBalance)" Caption="Operation Balance" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.Replenishment)" Caption="Replenishment" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.PreWithdrawals)" Caption="PreWithdrawals" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.Returns)" Caption="Returns" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.Withdrawals)" Caption="Withdrawals" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.CashPositionBalance)" Caption="Cash Position Balance" />
                 <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.ClosingBalance)" Caption="Closing Balance" />
                 @if (ShowBillColumn)
                {
                    <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.BillClosingBalance)" Caption="Bill Closing Balance" />
                    <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.BillOpeningBalance)" Caption="Bill Opening Balance" />
                    <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.BillReturns)" Caption="Bill Returns" />
                    <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.BillPreWthdrawals)" Caption="Bill Pre Withdrawals" />
                    <DataGridColumn Field="@nameof(BalanceInvestigationViewModel.BillWthdrawals)" Caption="Bill Withdrawals" />

                }
                @*  <DataGridCheckColumn TextAlignment="TextAlignment.Center" HeaderTextAlignment="TextAlignment.Center" TItem="BalanceInvestigationViewModel" Caption="Post Replenishment">
            <DisplayTemplate>
            <Button Clicked="@(()=>ShowModal(context))">
            <Icon Name="@("fa fa-address-card")" TextColor="TextColor.Primary" />
            </Button>
            </DisplayTemplate>
            </DataGridCheckColumn>
            *@
            </DataGrid>
            <EView360.Pages.Pagination pageNo="pageNo" maxPageNo="maxPageNo" totalRecords="totalRecords" OnSubmitCallback="GetDataByPageNo" />
        }

    </div>
    <Modal @ref="postRepModalRef">
        <ModalContent Centered>
            <ModalHeader>
                <ModalTitle>Add New Replenishment</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <EditForm id="EditReplenishmentModal" EditContext="editContext" OnValidSubmit=@Submit>

                <ModalBody>
                    <DataAnnotationsValidator />
                    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                    <Field Horizontal>
                        <FieldLabel ColumnSize="ColumnSize.Is3">ATM ID :</FieldLabel>
                        <FieldBody ColumnSize="ColumnSize.Is9"><TextEdit Placeholder="Please, select an ATM" Disabled @bind-Text="postRep.Title" /></FieldBody>
                     </Field>
                     <FieldLabel><h5>Selected ATM Denominations</h5></FieldLabel>

                     <Field Horizontal>
                        <FieldLabel ColumnSize="ColumnSize.Is6"> Denomination Value of Type 1:</FieldLabel>
                        <FieldBody ColumnSize="ColumnSize.Is6"><NumericEdit Disabled TValue="int" @bind-Value=postRep.DenominationType1 /></FieldBody>
                     </Field>
                     <Field Horizontal>
                        <FieldLabel ColumnSize="ColumnSize.Is6"> Denomination Value of Type 2:</FieldLabel>
                        <FieldBody ColumnSize="ColumnSize.Is6"><NumericEdit Disabled TValue="int" @bind-Value=postRep.DenominationType2 /></FieldBody>
                     </Field>
                     <Field Horizontal>
                        <FieldLabel ColumnSize="ColumnSize.Is6"> Denomination Value of Type 3:</FieldLabel>
                        <FieldBody ColumnSize="ColumnSize.Is6"><NumericEdit Disabled TValue="int" @bind-Value=postRep.DenominationType3 /></FieldBody>
                     </Field>
                     <Field Horizontal>
                        <FieldLabel ColumnSize="ColumnSize.Is6"> Denomination Value of Type 4:</FieldLabel>
                        <FieldBody ColumnSize="ColumnSize.Is6"><NumericEdit Disabled TValue="int" @bind-Value=postRep.DenominationType4 /></FieldBody>
                     </Field>
                     <Field>
                         <FieldLabel>Replenishment Date :</FieldLabel>
                         <DateEdit TValue="DateTime?" InputMode="DateInputMode.DateTime" @bind-Date=postRep.RepDatetime />
                     </Field>
                     <Field>
                         <FieldLabel>Counters for type 1:</FieldLabel>
                         <NumericEdit TValue="int?" @bind-Value=postRep.CashAdded1 />
                     </Field>
                     <Field>
                         <FieldLabel>Counters for type 2:</FieldLabel>
                         <NumericEdit TValue="int?" @bind-Value=postRep.CashAdded2 />
                     </Field>
                     <Field>
                         <FieldLabel>Counters for type 3:</FieldLabel>
                         <NumericEdit TValue="int?" @bind-Value=postRep.CashAdded3 />
                     </Field>
                     <Field>
                         <FieldLabel>Counters for type 4:</FieldLabel>
                         <NumericEdit TValue="int?" @bind-Value=postRep.CashAdded4 />
                     </Field>
                     <Field>
                         <FieldLabel>Is swap:</FieldLabel>
                         <Check TValue="bool" @bind-Checked=postRep.IsSwap />
                     </Field>
                     <Field>
                         <FieldLabel>Reason:</FieldLabel>
                         <TextEdit @bind-Text=postRep.Reason />
                     </Field>
                 </ModalBody>
             </EditForm>

             <ModalFooter>
                 <Button Color="Color.Secondary" Clicked="@HideModal">Close</Button>
                 <input type="submit" form="EditReplenishmentModal" class="btn btn-success" value="Save" />

             </ModalFooter>
         </ModalContent>
     </Modal>
 </div>


 <style>

     form {
         max-width: 100%;
     }

     .table-primary .showAnimation {
         animation: spin 1200ms linear infinite;
     }

     .table-responsive {
         border: 1px solid #dee2e6 !important;
         margin-top: 20px;
         width: 100%;
         background-color: white;
     }

     .all_headers {
         width: 170px;
         overflow: hidden;
         white-space: nowrap;
     }

     .btn-danger {
         margin-left: 5px;
     }

     .modal-body {
         height: 70vh;
         overflow-y: auto;
     }

     tr:nth-child(even) {
         background-color: #e9ecef;
     }

     .all_headers_form {
         margin-left: 12px;
         padding: 5px;
     }

     .filter_bar {
         height: calc(100vh - 3.5rem);
         overflow-y: auto;
         background-color: white;
     }

 </style>

 @if (@mode is not null)
{
    <style>
        .flatpickr-prev-month, .flatpickr-month .numInputWrapper, .flatpickr-next-month {
            visibility: hidden;
        }

        .flatpickr-month {
            font-size: large;
        }
    </style>
}



