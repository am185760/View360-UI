@inject UserManagementService userManagementService
@inject GroupRepository groupService
@inject AuditLogService auditLogService
@inject NoteSetTypeService service

@page "/AuditLog"
@using EView360.Data;
@using EView360.Services;
@using EView360Models.Core;
@using EView360Models.ViewModels;
@using Microsoft.AspNetCore.Mvc;
@using NPOI.XWPF.UserModel;
@using OfficeOpenXml;
@using System.Globalization;
@inject IJSRuntime JS

<div class="row content">
    <div class="col-sm-2 filter_bar border-right-2">
        <form style="margin-top: 20px;">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <h5>Filters: </h5>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label class="float-left" for="CreatedByName">Created By:</label>
                    <select @bind="filterCreatedBy" class="form-control">
                        <option value="">Any</option>
                        @foreach (var user in appUsers.Select(x => new { x.UserId, x.UserLogin }).Distinct())
                        {
                            <option value="@user.UserId">@user.UserLogin</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label class="float-left" for="CreatedByName">Rights :</label>
                    <select @bind="filterRights" class="form-control">
                        <option value="">Any</option>
                        @foreach (var right in rights.Select(x => new { x.RightId, x.Name }).Distinct())
                        {
                            <option value="@right.RightId">@right.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label for="inputEmail4">From Date: </label>
                    <DatePicker TValue="DateTime?" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@fromDate"></DatePicker>

                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label for="inputEmail4">To Date: </label>
                    <DatePicker TValue="DateTime?" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" Placeholder="Selete Date" @bind-Date="@toDate"></DatePicker>
                </div>
            </div>
            <input class="btn btn-success" type="button" onclick="@FilterSubmit" value="Search">
            <input class="btn btn-success" type="button" onclick="@ResetFilter" value="Reset">
            @*<input class="btn btn-success mt-2" type="button" onclick="@ExportToExcel" value="Export To Excel">*@
            @*<input class="btn btn-success" type="button" onclick="@ExportToPdf" value="Export To Pdf">*@
        </form>
    </div>


    <div class="col-sm-10 text-left" style="margin-top:1%">
        <div class="form-group">
            <h2>Activity Log</h2>
        </div>
        @if (showSpinner)
        {
            <div class="spinner" style="z-index:4"></div>
        }

        @if (showGrid)
        {
            <DataGrid TItem="AuditLogViewModel"
                  Data="@filteredAuditLogs"
                  Editable
                  Responsive="true"
                  ShowPager
                  UseValidation
                  ShowValidationsSummary="false"
                  ShowValidationFeedback
                  PopupSize="ModalSize.Large"
                  Bordered
                  PageSize="50"
                  FixedHeader
                  FixedHeaderDataGridHeight="570px"
                  FixedHeaderDataGridMaxHeight="570px"
                  Narrow="true"
                  Sortable  SortMode="DataGridSortMode.Single"
                  HeaderThemeContrast="@ThemeContrast.Light">


            <DataGridColumn Field="@nameof(AuditLogViewModel.UserLoginName)" Caption="User" />
            <DataGridColumn Field="@nameof(AuditLogViewModel.ActivityTime)" Caption="DateTime" DisplayFormat="{0:dd/MM/yyyy HH:mm:ss}" />
            <DataGridColumn Field="@nameof(AuditLogViewModel.Message)" Caption="Description" />

                 <DataGridCommandColumn>
                     <NewCommandTemplate />
                     <DeleteCommandTemplate />
                     <EditCommandTemplate>
                         @if (context.Item.Message.Contains("updated"))
                        {
                         <Button Clicked="@(()=>ShowDetails(context.Item.AuditLogId))" title="Details"><Icon Name="IconName.InfoCircle" TextColor="TextColor.Success" IconSize=IconSize.Small /></Button>
                        }
                     </EditCommandTemplate>
                 </DataGridCommandColumn>

            </DataGrid>
        }

        <Modal @ref="DetailedAuditDataGridRef">
            <ModalContent Centered Size="ModalSize.Large">
                 <ModalHeader>
                     <ModalTitle>
                         Audit Log Details 
                     </ModalTitle>
                     <CloseButton />
                 </ModalHeader>

                 <ModalBody>
                     <DataGrid @ref="@DetailedDataGridRef"
                               TItem="AuditLogDetail"
                               Data="@detailedAuditLog"
                               Editable
                               Responsive="true"
                               Bordered
                               PageSize="10000"
                               FixedHeader
                               FixedHeaderDataGridHeight="100%"
                               FixedHeaderDataGridMaxHeight="100%"
                               Narrow="true"
                               Sortable SortMode="DataGridSortMode.Single"
                               HeaderThemeContrast="@ThemeContrast.Light">


                         <DataGridColumn Field="@nameof(AuditLogDetail.FieldName)" Caption="Field Name" />
                         <DataGridColumn Field="@nameof(AuditLogDetail.OldValue)" Caption="Old Value" />
                         <DataGridColumn Field="@nameof(AuditLogDetail.NewValue)" Caption="New Value" />
                         
                         
                     </DataGrid>
                 </ModalBody>
                 @*<ModalFooter>
                <Button Color="Color.Secondary" Clicked="@HideModal">Close</Button>
                </ModalFooter>*@
             </ModalContent>
         </Modal>

    </div>
</div>



<style>

    .exportBtn {
        margin-top: 5%;
    }

    .table-responsive {
        border: 1px solid #dee2e6 !important;
        margin-top: 20px;
        width: 100%;
        background-color: white;
    }

    .all_headers {
        width: 170px;
        overflow: hidden;
        white-space: nowrap;
    }

    .btn-danger {
        margin-left: 5px;
    }

    .modal-body {
        height: 70vh;
        overflow-y: auto;
    }

    tr:nth-child(even) {
        background-color: #e9ecef;
    }

    .all_headers_form {
        margin-left: 12px;
        padding: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }
</style>


