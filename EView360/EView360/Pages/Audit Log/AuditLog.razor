    private void ResetFilter()
    {
        filteredAuditLogs = auditLogs;
        filterCreatedBy = string.Empty;
        filterRights = string.Empty;
        fromDate = DateTime.Now.Date;
        toDate = DateTime.Now.Date.AddDays(1).AddSeconds(-1);
        this.InvokeAsync(() => this.StateHasChanged());
        LoadData();
    }

    private void ExportToExcel()
    {

        ExcelGeneration();
    }

    private void ExportToPdf()
    {

        ExcelGeneration();
    }

    private void FilterSubmit()
    {
        filteredAuditLogs = auditLogs;

        LoadData();
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private void ExcelGeneration()
    {
        ExcelExport excelExport = new ExcelExport();
        excelExport.ExcelGenerate(JS, filteredAuditLogs);
    }
