    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);

        if (appUsers is null || appUsers.Count == 0)
        {
            appUsers = await userManagementService.GetAllUsers();
        }
        if (rights is null || rights.Count == 0)
        {
            rights = await groupService.GetRightsAsync();
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("handleDatePicker", objRef);

            //LoadData();
        }
    }

    public async void LoadData()
    {
        showSpinner = false;
        int? rightId = filterRights == string.Empty ? 0 : Convert.ToInt32(filterRights);
        int? userId = filterCreatedBy == string.Empty ? 0 : Convert.ToInt32(filterCreatedBy);

        if (fromDate > toDate)
        {
            await NotificationService.Error("To date must be greater than from date.", "Validation", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
            return;
        }

        auditLogs = filteredAuditLogs = await auditLogService.GetAuditLog(fromDate, toDate, rightId, userId);
        showSpinner = false;
        showGrid = true;
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private async void ShowDetails(long auditLogId)
    {
        detailedAuditLog = await auditLogService.GetDetailedAuditLog(auditLogId);
        DetailedAuditDataGridRef?.Show();
    }

