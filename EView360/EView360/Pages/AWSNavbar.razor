@code {
    [Inject] INotificationService NotificationService { get; set; }

    Dictionary<int, string> userRight;
    AppUser appUser;
    RightsViewModel rights = new();
    bool adminPermission, operationPermission, reportPermission, archivePermission, analyticPermission;
    private DotNetObjectReference<AWSNavbar>? objRef;
    private List<AutoCompletePageViewModel> autoCompletePageList = new List<AutoCompletePageViewModel>();
    string searchValue = string.Empty;

    [JSInvokable]
    public async Task Logout()
    {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsLoggedOut();
        atmRepository.ClearAtmSessionValues();
        NavigationManager.NavigateTo("");
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            objRef = DotNetObjectReference.Create(this);
            await jsRuntime.InvokeVoidAsync("initializeInactivityTimer", objRef);
            appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
            var permissions = await localStorage.GetItemAsync<Dictionary<int, string>>("userRights");
            if (permissions is not null)
            {
                userRight = permissions;
            }

            rights = await userService.GetRightsByType();
            adminPermission = CheckAdminViewPermission();
            operationPermission = CheckOperationViewPermission();
            reportPermission = CheckReportViewPermission();
            archivePermission = CheckArchiveViewPermission();
            analyticPermission = CheckPermission((int)Permissions.ViewGraphList);
            InitializePageList();
            await this.InvokeAsync(() => this.StateHasChanged());
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, CheckPermission as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private bool CheckPermission(int right)
    {
        try
        {
            if (userRight is not null)
                return userRight.ContainsKey(right);
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, CheckPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private bool CheckAdminViewPermission()
    {
        try
        {
            foreach (int id in userRight.Keys)
            {
                if (rights.AdminRights.Contains(id))
                    return true;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, CheckAdminViewPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private bool CheckOperationViewPermission()
    {
        try
        {
            foreach (int id in userRight.Keys)
            {
                if (rights.OperationRights.Contains(id))
                    return true;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at NavMenu, CheckOperationViewPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private bool CheckReportViewPermission()
    {
        try
        {
            foreach (int id in userRight.Keys)
            {
                if (rights.ReportRights.Contains(id))
                    return true;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at NavMenu, CheckReportViewPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private bool CheckArchiveViewPermission()
    {
        try
        {
            foreach (int id in userRight.Keys)
            {
                if (rights.ArchiveRights.Contains(id))
                    return true;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at NavMenu, CheckArchiveViewPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    public async Task NavigateToWindow(string url)
    {
        string baseurl = $"{NavigationManager.BaseUri}{url}";
        await jsRuntime.InvokeVoidAsync("open", baseurl, "_blank", "location=yes,height=1000,width=5000,scrollbars=yes,status=yes");
    }

    private void HandleClick(string pageName)
    {
        if (!string.IsNullOrEmpty(pageName))
        {
            NavigationManager.NavigateTo($"{NavigationManager.BaseUri}/EmptyPage");
            NavigationManager.NavigateTo(pageName, false);
        }
    }

    public async Task OpenDashboard(string url)
    {
        List<string> atmIDs = new();
        List<string> regionIDs = new();
        string filter = string.Empty;

        string baseurl = $"{NavigationManager.BaseUri}{url}";
        (atmIDs, regionIDs) = await atmRepository.GetSelectedAtmOrRegionList();
        if (regionIDs?.Count > 0)
        {
            filter = "(" + string.Join(",", regionIDs) + ")";
            baseurl += $"/true/{filter}";
        }
        else
        {
            filter = "(" + string.Join(",", atmIDs) + ")";
            baseurl += $"/false/{filter}";
        }
        await jsRuntime.InvokeVoidAsync("open", baseurl, "_blank", "location=yes,height=1000,width=5000,scrollbars=yes,status=yes");
    }

