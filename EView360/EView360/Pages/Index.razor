            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    public async Task NavigateToWindow(string url)
    {
        try
        {
            string baseurl = $"{NavigationManager.BaseUri}{url}";
            await jsRuntime.InvokeVoidAsync("open", baseurl, "_blank", "location=yes,height=1000,width=5000,scrollbars=yes,status=yes");
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, NavigateToWindow as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    public async Task NavigateToPage(string page)
    {
        try
        {
            NavigationManager.NavigateTo(page, false);
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Index, NavigateToPage as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

