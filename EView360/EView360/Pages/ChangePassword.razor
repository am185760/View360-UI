@page "/ChangePassword"
@using EView360.Services;
@using Encryption;
@using global::Common.RequestModel;
@using global::Common.ViewModel;
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ILogger<ChangePassword> logger
@inject UserManagementService service
<div class="container mt-5">
@*    <div class="form-group">

        <h2>Change Password</h2>
    </div>*@
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }
    <Card>
        <CardHeader><h2>Change Password</h2></CardHeader>
        <CardBody>
            <Form>
                <Validations Mode="ValidationMode.Manual" Model="@changePassword" @ref="validations">
                    <Validation>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is2">Password</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is10">
                                <TextEdit Placeholder="Password" @bind-Text="@changePassword.Password" Role="TextRole.Password">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is2">New Password</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is10">
                                <TextEdit Role="TextRole.Password" Placeholder="New Password" @bind-Text="@changePassword.NewPassword">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is2">Confirm Password</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is10">
                                <TextEdit Role="TextRole.Password" Placeholder="Confirm password" @bind-Text="@changePassword.ConfirmPassword">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Button Class="btn btn-success mt-2 float-right" value="Save" Clicked="@SubmitHandler">Save</Button>
                </Validations>
            </Form>
        </CardBody>
    </Card>
</div>
@code {
    [Inject] INotificationService NotificationService { get; set; }
    [Inject] IMessageService MessageService { get; set; }

    private ChangePasswordViewModel changePassword = new ChangePasswordViewModel();
    private EditContext? editContext;

    private ValidationMessageStore? messageStore;
    Validations validations;

    public string schedule { get; set; }
    private bool showSpinner = false;
    private bool showGrid = false;
    private bool showModal = false;
    private bool isEdit = false;
    private bool showScheduleTime = false;
    EView360Models.Core.AppUser appUser;

    protected override async Task OnInitializedAsync()
    {
        editContext = new(changePassword);
        //editContext.OnValidationRequested += CustomValidations;
        //messageStore = new();
        appUser = await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser");
    }

    //protected override void OnInitialized()
    //{
    //    editContext = new(changePassword);
    //    editContext.OnValidationRequested += CustomValidations;
    //    messageStore = new(editContext);
    //}


    private void CustomValidations()
    {
        messageStore?.Clear();

        messageStore?.Add(() => changePassword.Password, "Password do not match, please enter a valid password");

    }

    private async Task SubmitHandler()
    {
        try
        {
            if (await validations.ValidateAll())
            {
                string response = string.Empty;
                ChangePasswordRequestModel model = new();
                if (appUser.UserPassword == Encryption.Cryptic.EncryptString(changePassword.Password, Helper.ConstractKey(false)))
                {
                    showSpinner = true;
                    model.UserId = appUser.UserId;
                    model.Password = Encryption.Cryptic.EncryptString(changePassword.NewPassword, Helper.ConstractKey(false));
                    response = await service.UpdateUserPassword(model);
                    changePassword.NewPassword = changePassword.Password = changePassword.ConfirmPassword = string.Empty;
                    showSpinner = false;
                    await this.InvokeAsync(() => this.StateHasChanged());

                }
                else
                {

                    await NotificationService.Error("Password is incorrect .", "Error", (options) =>
                        {
                            options.IntervalBeforeClose = 4000;
                        });
                }

                //response = await service.UpdateAlertType(scheduleReport);
                //if (response == "error")
                //{
                //    await NotificationService.Error("An error occured while updating schedule reports, check logs..", "Error", (options) =>
                //    {
                //        options.IntervalBeforeClose = 4000;
                //    });
                //}

                //if (response != "error")
                //{
                //    await NotificationService.Success("Changes completed successfully.", "Success", (options) =>
                //    {
                //        options.IntervalBeforeClose = 4000;
                //    });
                //}
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Change Password, SubmitHandler as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }
    void ValidateEmail(ValidatorEventArgs e)
    {
        var email = Convert.ToString(e.Value);

        e.Status = string.IsNullOrEmpty(email) ? ValidationStatus.None :
            email.Contains("@") ? ValidationStatus.Success : ValidationStatus.Error;
    }
}
