                                     @*<DataGridColumn TItem="DBServerInfo" Field="@nameof(DBServerInfo.ServerConnection)" Caption="Server Connection" />
                                <DataGridColumn TItem="DBServerInfo" Field="@nameof(DBServerInfo.ServerCredentials)" Caption="Server Credentials" />
                                <DataGridColumn TItem="DBServerInfo" Field="@nameof(DBServerInfo.MaxPoolSize)" Caption="Max Pool Size" />*@
                                     <DataGridColumn TItem="DBServerInfo" Field="@nameof(DBServerInfo.MaxATMs)" Caption="Max Atms" />
                                     <DataGridColumn TItem="DBServerInfo" Field="@nameof(DBServerInfo.AtmInfo)" Caption="Atm List">
                                         <DisplayTemplate>
                                             <Button Clicked="@(()=>ShowAtmList(context.ServerName))">
                                                 <Icon Name="@("fa-newspaper-o")" TextColor="TextColor.Success" />
                                             </Button>
                                         </DisplayTemplate>
                                     </DataGridColumn>
                                 </DataGrid>
                             </form>
                         </TabPanel>
                         <TabPanel Name="AppServersInfo">
                             <form class="" style="margin-top: 3%;margin-left: 1%;">
                                 <DataGrid @ref="@dataGridRef2"
                                           TItem="AppServerInfo"
                                           Data="@AppServers"
                                           Editable="false"
                                           Responsive="true"
                                                        ShowPager
                                                        UseValidation
                                           PopupSize="ModalSize.Large"
                                                        Bordered
                                           PageSize="50"
                                                        FixedHeader
                                           FixedHeaderDataGridHeight="400px"
                                           FixedHeaderDataGridMaxHeight="400px"
                                           Narrow="true"
                                                        Sortable SortMode="DataGridSortMode.Single"
                                           HeaderThemeContrast="@ThemeContrast.Light">


                                     @*<DataGridColumn TItem="AppServerInfo" Field="@nameof(AppServerInfo.ServerName)" Caption="Server Name" />*@
                                     <DataGridColumn TItem="AppServerInfo" Field="@nameof(AppServerInfo.ServerIP)" Caption="Server IP" />
                                     <DataGridColumn TItem="AppServerInfo" Field="@nameof(AppServerInfo.ServerPort)" Caption="Server Port" />
                                 </DataGrid>
                             </form>
                         </TabPanel>
                     </Content>
                 </Tabs>
                 <div class="modal-footer float-left">
                     @if (CheckPermission((int)Permissions.ChangeConfiguration))
                    {
                        <button type="submit" form="EditAppConf" class="btn btn-success" disabled="@IsDisabled">
                            <span class="@btnSpinner spinner-border-sm" role="status" aria-hidden="true"></span>
                            Save
                        </button>
                    }
                    <input type="button" class="btn btn-secondary" disabled="@IsDisabled" value="Cancel" @onclick="@(x => NavigationManager.NavigateTo($"{NavigationManager.BaseUri}"))" />
                </div>
            </EditForm>

            <Modal @ref="atmLstModalRef">
                <ModalContent Centered Size="ModalSize.Large">
                     <ModalHeader>
                         <ModalTitle>Atm List</ModalTitle>
                         <CloseButton />
                     </ModalHeader>
                     <ModalBody MaxHeight="50">
                         <div>
                             <ListView TItem="KeyValuePair<string, string>"
                                       Data="AtmInfo"
                                       TextField="(item) => item.Value"
                                       ValueField="(item) => item.Key"
                                       Mode="ListGroupMode.Static"
                                       MaxHeight="300px">
                                 <ItemTemplate>
                                     <Div Flex="Flex.InlineFlex.JustifyContent.Between" Width="Width.Is100">
                                         <Small>@context.Item.Value</Small>
                                         <Small>@context.Item.Key</Small>
                                     </Div>
                                 </ItemTemplate>
                             </ListView>
                         </div>
                     </ModalBody>
                 </ModalContent>
             </Modal>
        }
    </div>
</div>

<style>

    .table-responsive {
        border: 1px solid #dee2e6 !important;
        margin-top: 20px;
        width: 100%;
        background-color: white;
    }

    .appConfigSpinner {
        margin-top: 15%;
    }

    .form-group {
        margin-bottom: 0.2rem;
    }

    .flatpickr-time {
        width: 90%;
    }

    .flatpickr-calendar.open {
        width: 10%;
    }

    .CJR_row {
        margin-left: 1%;
    }

    .CJR_heading {
        margin-left: 3%;
        margin-top: 1%;
    }

    .status.Started {
        color: #2c9912;
    }

    .status.Stopped {
        color: red;
    }
</style>

@code {

    private bool showSpinner = true;
    private bool showGrid = false;
    private EView360Models.Core.AppSetting appSetting = new();
    private List<EView360Models.Core.CcmsService> ccmsServices = new();
    private EditContext? editContext;
    private long userId;
    TimePicker<TimeSpan>? timePickerDailyFeed = new();
    private string? TabName = "CMSG";
    TimePicker<TimeSpan>? timePicker = new();
    private ServersInformation serversInformation = new();
    private List<DBServerInfo> DBServers = new();
    private List<AppServerInfo> AppServers = new();
    private DataGrid<DBServerInfo>? dataGridRef;
    private DataGrid<AppServerInfo>? dataGridRef2;
    private Modal? atmLstModalRef;
    public Dictionary<string, string> AtmInfo = new();
    public string currentServerIp = string.Empty;
    private bool IsDisabled = false;
    private string btnSpinner = string.Empty;

    [Inject] INotificationService NotificationService { get; set; }
    [Inject] AuditLogService auditService { get; set; }
    Dictionary<int, string> userRights;

    protected async override void OnInitialized()
    {
        userRights = await localStorage.GetItemAsync<Dictionary<int, string>>("userRights");
        userId = (await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser")).UserId;
        service.UserId = userId;
        editContext = new(appSetting);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await LoadData();
                ccmsServices = await service.GetCCMSService();
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AppConf., OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private bool CheckPermission(int right)
    {
        try
        {
            if (userRights is not null)
                return userRights.ContainsKey(right);
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AppConfig, CheckPermission as: {ex.Message}");

            NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        return false;
    }

    private async Task LoadData()
    {
        try
        {
            appSetting = await service.GetAppSettingAsync();
            if (appSetting is null)
            {
                await NotificationService.Info("No record found or check logs for error", "Information", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
            }

            if (appSetting != null && appSetting.ServersInfo != null)
            {
                currentServerIp = appSetting.ServerIp;
                string ascii = Encoding.ASCII.GetString(appSetting.ServersInfo);
                if (!string.IsNullOrEmpty(ascii))
                {
                    serversInformation = JsonConvert.DeserializeObject<ServersInformation>(ascii)!;
                    DBServers = serversInformation.DBServers;
                    AppServers = serversInformation.AppServers;
                    DBServers.Select(d => { d.ServerConnection = Encryption.Cryptic.DecryptString(d.ServerConnection, Helper.ConstractKey(false)); return d; }).ToList();
                    DBServers.Select(d => { d.ServerCredentials = Encryption.Cryptic.DecryptString(d.ServerCredentials, Helper.ConstractKey(false)); return d; }).ToList();
                }
            }


            timePicker = new TimePicker<TimeSpan>() { Time = appSetting.CashOrderExecutionTime.TimeOfDay };
            timePickerDailyFeed.Time = appSetting.DailyFeedGenerationTime.HasValue ? appSetting.DailyFeedGenerationTime.Value.TimeOfDay : TimeSpan.Zero;
            editContext = new(appSetting);
            showSpinner = false;
            showGrid = true;
            this.InvokeAsync(() => this.StateHasChanged());
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AppConf., LoadData as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }

    }

    private void ShowAtmList(string serverName)
    {
        AtmInfo = DBServers.Where(x => x.ServerName == serverName).FirstOrDefault().AtmInfo;

        atmLstModalRef.Show();
    }

    void SetTabPanel(string tabName)
    {
        TabName = tabName;
    }

    void OnSwitchChange(bool value, string serviceName)
    {
        ccmsServices.Where(x => x.Name == serviceName)
        .Select(x => { x.IsStartScheduled = value; x.IsStopScheduled = !value; x.ServiceStatus = (value ? "Started" : "Stopped"); return x; }).ToList();
    }

    private async Task SubmitHandler()
    {
        try
        {
            IsDisabled = true;
            btnSpinner = "spinner-border";
            StateHasChanged();

            appSetting.CashOrderExecutionTime = DateTime.Today.AddHours(timePicker.Time.Hours).AddMinutes(timePicker.Time.Minutes);
            appSetting.DailyFeedGenerationTime = DateTime.Today.AddHours(timePickerDailyFeed.Time.Hours).AddMinutes(timePickerDailyFeed.Time.Minutes);

            string responseAppSetting = await service.UpdateAppSetting(appSetting);
            string responseService = await service.UpdateCCMSServices(ccmsServices);

            IsDisabled = false;
            btnSpinner = "";
            StateHasChanged();

            if (responseAppSetting.ToLower().Contains("error"))
            {
                await NotificationService.Error(responseAppSetting, "Error", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
            }
            if (responseService.ToLower().Contains("error"))
            {
                await NotificationService.Error(responseService, "Error", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
            }
            if (!responseAppSetting.ToLower().Contains("error") && !responseService.ToLower().Contains("error"))
            {
                if (appSetting.ServerIp != currentServerIp)
                {
                    string response = await atmTaskService.ScheduleConfiguration(atmTreeService.AtmList.Select(x => x.AtmId).ToList());
                    if (response == "success" || response == Common.Constants.Messages.AtmAlreadyScheduleMsg)
                    {
                        await NotificationService.Success("Task configured successfully as Server Ip changed.", "Success", (options) =>
                        {
                            options.IntervalBeforeClose = 4000;
                        });
                    }
                }
                await NotificationService.Success("App Config. changes update", "Success", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
                //await Task.Delay(1000);
                //NavigationManager.NavigateTo("/index");
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AppConf., SubmitHandler as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }
}
