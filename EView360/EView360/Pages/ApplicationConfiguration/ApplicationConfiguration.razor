                        <TabPanel Name="DailyFeedConfiguration">
                            <form class="" style="margin-top: 3%;margin-left: 1%;">
                                <div class="form-group row">
                                    <label for="serverIp" class="col-sm-2 col-form-label col-form-label-sm">
                                        FTP Uri
                                    </label>
                                    <div class="col-sm-2">
                                        <InputText class="form-control form-control-sm" id="serverIp" @bind-Value="appSetting.DailyFeedFtpUri" />
                                    </div>
                                    <Tooltip Text="This is the ftp location on which daily feed files will be uploaded">
                                        <Icon Name="IconName.ExclamationCircle" IconSize="IconSize.Small" TextColor="TextColor.Success" />
                                    </Tooltip>
                                </div>
                                <div class="form-group row">
                                    <label for="serverIp" class="col-sm-2 col-form-label col-form-label-sm">
                                        FTP Username
                                    </label>
                                    <div class="col-sm-2">
                                        <InputText class="form-control form-control-sm" id="serverIp" @bind-Value="appSetting.DailyFeedFtpUsername" />
                                    </div>
                                    <Tooltip Text="This is the username for the specified ftp location.">
                                        <Icon Name="IconName.ExclamationCircle" IconSize="IconSize.Small" TextColor="TextColor.Success" />
                                    </Tooltip>
                                </div>
                                <div class="form-group row">
                                    <label for="serverIp" class="col-sm-2 col-form-label col-form-label-sm">
                                        FTP Password
                                    </label>
                                    <div class="col-sm-2">
                                        <InputText type="password" class="form-control form-control-sm" id="serverIp" @bind-Value="appSetting.DailyFeedFtpPassword" />
                                    </div>
                                    <Tooltip Text="This is the password for the specified ftp location.">
                                        <Icon Name="IconName.ExclamationCircle" IconSize="IconSize.Small" TextColor="TextColor.Success" />
                                    </Tooltip>
                                </div>
                                <div class="form-group row">
                                    <label for="defaultPort" class="col-sm-2 col-form-label col-form-label-sm">DFs Generation Time</label>
                                    <div class="col-sm-2">
                                        <Addons>
                                            <Addon AddonType="AddonType.Body">
                                                <TimePicker @ref="@timePickerDailyFeed" TValue="TimeSpan" Size="Size.Small" />
                                            </Addon>
                                            <Addon AddonType="AddonType.End" Size="Size.Small">
                                                <Button Color="Color.Light" Clicked="@(()=>timePickerDailyFeed.ToggleAsync())" Size="Size.Small">
                                                    <Icon Name="IconName.CalendarDay" IconSize="IconSize.Small" />
                                                </Button>
                                            </Addon>
                                        </Addons>
                                    </div>
                                    <Tooltip Text="This will be time at which daily feed file will be generated.">
                                        <Icon Name="IconName.ExclamationCircle" IconSize="IconSize.Small" TextColor="TextColor.Success" />
                                    </Tooltip>
                                </div>

                                <div class="form-group row">
                                    <label for="serverIp" class="col-sm-2 col-form-label col-form-label-sm">
