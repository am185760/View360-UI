@code {
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private DotNetObjectReference<UserForm>? objRef;
    private string userPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string oldPassword = string.Empty;
    private bool showUserTree = false;
    private EView360.Data.TreeView bankTreeView = new();
    private bool toggle = false;

    [Inject] INotificationService NotificationService { get; set; }

    [Parameter] public UserViewModel thisUser { get; set; }
    [Parameter] public EventCallback<UserViewModel> OnSubmitCallback { get; set; }
    [Parameter] public EventCallback<UserViewModel> OnCancelCallback { get; set; }
    [Parameter] public List<UserViewModel> appUsers { get; set; }
    [Parameter] public bool isEdit { get; set; }


    protected async override Task OnInitializedAsync()
    {
        try
        {
            editContext = new(thisUser);
            editContext.OnValidationRequested += CustomValidations;
            messageStore = new(editContext);
            objRef = DotNetObjectReference.Create(this);
            showUserTree = true;
            bankTreeView = await atmRepository.BuidATMTreeView(atmRepository.RegionList, atmRepository.AtmList);
            notifyService.OnNodeChange += ReloadOnNodeChange;
            if (isEdit)
            {
                userPassword = confirmPassword = oldPassword = thisUser.User.UserPassword;
                if (thisUser.Alerts.All(x => x.isSelected) == true)
                {
                    toggle = true;
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at User Form, OnInitializedAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (bankTreeView != null)
            {
                if (thisUser.AtmIds == null)
                    thisUser.AtmIds = new string[0];
                await jsRuntime.InvokeVoidAsync("renderComponents", objRef, thisUser.AtmIds.Select(Id => 'a' + Id).ToArray());
            }
        }
    }

    private void CustomValidations(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();

        if (!isEdit)
        {
            List<UserViewModel> users = new();
            users = appUsers.Where(x => x.User.UserLogin != thisUser.User.UserLogin).ToList();

            if (string.IsNullOrEmpty(thisUser.User.UserLogin))
                messageStore?.Add(() => thisUser.User.UserLogin, "Please enter a Login ID");

            if (string.IsNullOrEmpty(thisUser.User.UserFullName))
                messageStore?.Add(() => thisUser.User.UserFullName, "Please enter the user full name");

            foreach (var user in users)
            {
                if (user.User.UserLogin.Equals(thisUser.User.UserLogin))
                {
                    messageStore?.Add(() => thisUser.User.UserLogin, "User Name already exists, please provide a unique name");
                    break;
                }
            }
        }
    }

    private async void SubmitHandler()
    {
        thisUser.AtmIds = await jsRuntime.InvokeAsync<string[]>("getCheckboxSelection", objRef);
        await OnSubmitCallback.InvokeAsync(thisUser);
    }

    private void AllCheckChanged(bool value)
    {
        toggle = value;

        if (value)
        {
            thisUser.Alerts.Select(x => { x.isSelected = true; return x; }).ToList();
        }
        else
        {
            thisUser.Alerts.Select(x => { x.isSelected = false; return x; }).ToList();
        }
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private void ChangeToggle()
    {
        if (thisUser.Alerts.All(x => x.isSelected) == true)
        {
            toggle = true;
        }
        else
        {
            toggle = false;
        }
    }
    //event to occour when tree node renamed, deleted, moved or region added
    private async void ReloadOnNodeChange()
    {
        showUserTree = false;
        StateHasChanged();
        bankTreeView = await atmRepository.BuidATMTreeView(atmRepository.RegionList, atmRepository.AtmList);
        showUserTree = true;
        StateHasChanged();
        await jsRuntime.InvokeVoidAsync("renderComponents", objRef, thisUser.AtmIds.Select(Id => 'a' + Id).ToArray());
    }
    public void Dispose()
    {
        objRef?.Dispose();
        notifyService.OnNodeChange -= ReloadOnNodeChange;
    }
}
