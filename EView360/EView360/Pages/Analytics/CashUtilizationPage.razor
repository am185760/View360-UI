@page "/CashUtilization"
@using EView360.Services.Analytics;
@using EView360.Services;
@using EView360Models.Core;
@using EView360Models.ViewModels;
@using Blazorise.LoadingIndicator
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ILogger<CashUtilizationPage> logger
@inject CashUtilizationService service
@inject IJSRuntime jsRuntime
@inject ATMTreeViewRepository atmRepository
@inject NotifyService notifyService
@implements IDisposable

<div class="row content">
    <div class="col-sm-2 filter_bar border-right-2">
        <form style="margin-top: 20px;">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <h5>Filters: </h5>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>From Date: </label>
                    <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Select Date" @bind-Date="@fromDate"></DatePicker>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>To Date: </label>
                    <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Select Date" @bind-Date="@toDate"></DatePicker>

                </div>
            </div>
            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@FilterSubmit" value="Search">
            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@ResetFilter" value="Reset">

        </form>
    </div>
    <div class="col-sm-10 text-left content_body" style="margin-top:1%">
        <div>
            <b><h2 style="font-family:montserrat; font-weight:bold">Cash Utilization Analysis</h2></b>
        </div>
        <div class="container" style="margin-top:2%; max-width:100% !important;">
            <div class="row">
                <div class="col-sm">
                    <LoadingIndicator @ref="loader1">
                        <div class="card mb-5" style="max-height: 403px;min-height: 403px;">
                            <h5 class="card-header">ATM Cash Utilization for today</h5>
                            <h6 class="card-header">Today [@DateTime.Now.ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showChart)
                                {
                                    <div class="mb-2">
                                        <Chart @ref="pieChart" Type="ChartType.Pie" TItem="double" Options="@chartOptions" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
                <div class="col-sm">
                    <LoadingIndicator @ref="loader2">
                        <div class="card mb-5" style="max-height: 403px;min-height: 403px;">
                            <h5 class="card-header">ATM Cash Utilization for last week</h5>
                            <h6 class="card-header">Last Week [@DateTime.Today.AddDays(-7).ToString("dd/MM/yyyy") - @DateTime.Today.AddDays(-1).ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showChart2)
                                {
                                    <div class="mb-2">
                                        <LineChart @ref="lineChartLastWeek" TItem="double" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
            </div>
            <div class="row">
                <div class="col-sm">
                    <LoadingIndicator @ref="loader3">
                        <div class="card mb-5" style="max-height: 403px;min-height: 403px;">
                            <h5 class="card-header">ATM Cash Utilization for specified duration</h5>
                            <h6 class="card-header">Selection Criteria [@fromDate.ToString("dd/MM/yyyy") - @toDate.ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showChart3)
                                {
                                    <div class="mb-2">
                                        <LineChart @ref="lineChartDuration" TItem="double" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
                <div class="col-sm">
                    <LoadingIndicator @ref="loader4">
                        <div class="card mb-5" style="max-height: 403px;min-height: 403px;">
                            <h5 class="card-header">ATM Cash Utilization for previous week</h5>
                            <h6 class="card-header">Previous Week [@DateTime.Today.AddDays(-14).ToString("dd/MM/yyyy") - @DateTime.Today.AddDays(-8).ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showChart4)
                                {
                                    <div class="mb-2">
                                        <LineChart @ref="lineChartPreviousWeek" TItem="double" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
            </div>
        </div>

    </div>
</div>

<style>



    .btn-danger {
        margin-left: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }

    .content_body {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
    }
</style>


@code {
    static DateTime currentTime = DateTime.Now;
    DateTime fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
    DateTime toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
    DatePicker<DateTime>? dateRef;
    [Inject] INotificationService NotificationService { get; set; }
    [Inject] IMessageService MessageService { get; set; }
    private AppUser appUser = null;
    bool showChart = false;
    bool showChart2 = false;
    bool showChart3 = false;
    bool showChart4 = false;
    private List<CashUtilizationViewModel> cashUtilizationForDuration = new();
    private List<CashUtilizationViewModel> cashUtilizationForToday = new();
    private List<CashUtilizationViewModel> cashUtilizationForLastWeek = new();
    private List<CashUtilizationViewModel> cashUtilizationForPreviousWeek = new();

    int transactingCount = 0;
    int noTransactingCount = 0;

    private Chart<double>? pieChart;
    LineChart<double>? lineChartLastWeek;
    LineChart<double>? lineChartPreviousWeek;
    LineChart<double>? lineChartDuration;

    ChartOptions chartOptions = new() { AspectRatio = 1.9 };
    private string[] Labels = { "Total Utilizations", "Total Non-Utilizations" };

    List<string> backgroundColors = new List<string> { ChartColor.FromRgba(255, 99, 132, 0.2f), ChartColor.FromRgba(54, 162, 235, 0.2f), ChartColor.FromRgba(255, 206, 86, 0.2f), ChartColor.FromRgba(75, 192, 192, 0.2f), ChartColor.FromRgba(153, 102, 255, 0.2f), ChartColor.FromRgba(255, 159, 64, 0.2f) };
    List<string> borderColors = new List<string> { ChartColor.FromRgba(255, 99, 132, 1f), ChartColor.FromRgba(54, 162, 235, 1f), ChartColor.FromRgba(255, 206, 86, 1f), ChartColor.FromRgba(75, 192, 192, 1f), ChartColor.FromRgba(153, 102, 255, 1f), ChartColor.FromRgba(255, 159, 64, 1f) };


    private List<string> backgroundColorsPie = new() { ChartColor.FromHtmlColorCode("#54b948"), ChartColor.FromHtmlColorCode("#FF2822") };
    private List<string> borderColorsPie = new() { ChartColor.FromHtmlColorCode("#509049"), ChartColor.FromHtmlColorCode("#B12230") };

    private bool IsDisabled = false;
    LoadingIndicator? loader1, loader2, loader3, loader4;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            notifyService.OnAtmChange += AtmSelected;
            notifyService.OnRegionChange += AtmSelected;
        }
        catch (Exception ex)
        {

        }

    }

    private async void AtmSelected()
    {
        FilterSubmit();
    }

    public void Dispose()
    {
        notifyService.OnAtmChange -= AtmSelected;
        notifyService.OnRegionChange -= AtmSelected;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await jsRuntime.InvokeVoidAsync("handleDatePicker", DotNetObjectReference.Create(this));
                appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
                if (appUser is not null)
                {
                    service.UserId = appUser.UserId;
                }
                this.InvokeAsync(() => this.StateHasChanged());
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Cash Utliz. page, OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private async void HandleDateSpecificUtilization()
    {
        CashUtilRespWrapper cashUtilizations = new();
        cashUtilizations = await service.GetCashUtilization(fromDate, toDate);

        if (!string.IsNullOrEmpty(cashUtilizations.Error))
        {
            await NotificationService.Error(cashUtilizations.Error, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        // For Specific Duration
        if (cashUtilizations.IsSucess && cashUtilizations.cashUtilizationViews?.Count > 0)
            cashUtilizationForDuration = cashUtilizations.cashUtilizationViews;

        showChart3 = true;
        this.InvokeAsync(() => this.StateHasChanged());
        await Task.Delay(50);

        if (cashUtilizationForDuration?.Count > 0)
            await HandleRedraw(lineChartDuration, GetChartLabel(cashUtilizationForDuration), GetChartData(cashUtilizationForDuration));

        await loader3.Hide();
    }

    private async void HandleTodayUtilization()
    {
        CashUtilRespWrapper cashUtilizations = new();
        cashUtilizations = await service.GetTodayCashUtilization(DateTime.Today, DateTime.Today);

        if (!string.IsNullOrEmpty(cashUtilizations.Error))
        {
            await NotificationService.Error(cashUtilizations.Error, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        // For Today
        if (cashUtilizations.IsSucess && cashUtilizations.cashUtilizationViews?.Count > 0)
        {
            cashUtilizationForToday = cashUtilizations.cashUtilizationViews;
            transactingCount = int.Parse(cashUtilizationForToday.First().result.Value.ToString("N0"));
            noTransactingCount = 100 - transactingCount;
        }

        showChart = true;
        this.InvokeAsync(() => this.StateHasChanged());
        await Task.Delay(50);

        if (cashUtilizationForToday?.Count > 0)
            await HandleRedraw(pieChart, GetPieChartDataset);

        await loader1.Hide();
    }

    private async void HandleLastWeekUtilization()
    {
        CashUtilRespWrapper cashUtilizations = new();
        cashUtilizations = await service.GetCashUtilization(DateTime.Today.AddDays(-7), DateTime.Today.AddDays(-1));

        if (!string.IsNullOrEmpty(cashUtilizations.Error))
        {
            await NotificationService.Error(cashUtilizations.Error, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }

        // For Last Week
        if (cashUtilizations.IsSucess && cashUtilizations.cashUtilizationViews?.Count > 0)
            cashUtilizationForLastWeek = cashUtilizations.cashUtilizationViews;

        showChart2 = true;
        this.InvokeAsync(() => this.StateHasChanged());
        await Task.Delay(50);


        if (cashUtilizationForLastWeek?.Count > 0)
            await HandleRedraw(lineChartLastWeek, GetChartLabel(cashUtilizationForLastWeek), GetChartData(cashUtilizationForLastWeek));
        await loader2.Hide();
    }

    private async void HandlePreviousWeekUtilization()
    {
        CashUtilRespWrapper cashUtilizations = new();
        cashUtilizations = await service.GetCashUtilization(DateTime.Today.AddDays(-14), DateTime.Today.AddDays(-8));

        if (!string.IsNullOrEmpty(cashUtilizations.Error))
        {
            await NotificationService.Error(cashUtilizations.Error, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }

        // For Previous Week
        if (cashUtilizations.IsSucess && cashUtilizations.cashUtilizationViews?.Count > 0)
            cashUtilizationForPreviousWeek = cashUtilizations.cashUtilizationViews;

        showChart4 = true;
        this.InvokeAsync(() => this.StateHasChanged());
        await Task.Delay(50);


        if (cashUtilizationForLastWeek?.Count > 0)
            await HandleRedraw(lineChartLastWeek, GetChartLabel(cashUtilizationForLastWeek), GetChartData(cashUtilizationForLastWeek));
        await loader4.Hide();
    }

    private async void FilterSubmit()
    {
        //IsDisabled = true;
        await loader1.Show();
        await loader2.Show();
        await loader3.Show();
        await loader4.Show();

        showChart = false;
        showChart2 = false;
        showChart3 = false;
        showChart4 = false;

        await this.InvokeAsync(() => this.StateHasChanged());

        cashUtilizationForDuration = new();
        cashUtilizationForToday = new();
        cashUtilizationForLastWeek = new();
        cashUtilizationForPreviousWeek = new();

        transactingCount = 0;
        noTransactingCount = 0;
        await Task.Delay(5);

        Task.Run(() => HandleDateSpecificUtilization());
        Task.Run(() => HandleTodayUtilization());
        Task.Run(() => HandlePreviousWeekUtilization());
        Task.Run(() => HandleLastWeekUtilization());
    }

    public List<double> GetChartData(List<CashUtilizationViewModel> cashUtilizationViews)
    {
        List<double> cashValues = new();
        float maxFloat = -1;

        foreach (var cashUtilization in cashUtilizationViews?.OrderBy(x => x.Date).ToList())
        {
            float dataVal = float.Parse(cashUtilization.result.ToString());
            if (dataVal > 0)
            {
                cashValues.Add(Math.Round(dataVal, 2));

                if (maxFloat < dataVal)
                    maxFloat = dataVal;
            }
        }
        return cashValues;
    }

    public List<string> GetChartLabel(List<CashUtilizationViewModel> cashUtilizationViews)
    {
        List<string> Labels = new();

        foreach (var cashUtilization in cashUtilizationViews?.OrderBy(x => x.Date).ToList())
        {
            if (float.Parse(cashUtilization.result.ToString()) > 0)
            {
                Labels.Add(cashUtilization.Date.Value.ToString("dd/MM/yyyy"));
            }
        }
        return Labels;
    }

    LineChartDataset<double> GetLineChartDataset(List<double> chartData)
    {
        return new LineChartDataset<double>
            {
                Label = "Utilization",
                Data = chartData,
                BackgroundColor = backgroundColors[0],
                BorderColor = borderColors[0],
                PointBackgroundColor = Enumerable.Repeat(borderColors.First(), chartData.Count).ToList(),
                Fill = false,
                PointRadius = 3,
                CubicInterpolationMode = "monotone"
            };
    }

    private async void ResetFilter()
    {
        fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
        toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
        this.InvokeAsync(() => this.StateHasChanged());
    }


    async Task HandleRedraw(LineChart<double>? lineChart, List<string> labels, List<double> chartData)
    {
        if (lineChart != null)
        {
            await lineChart.Clear();
            await lineChart.AddLabelsDatasetsAndUpdate(labels, GetLineChartDataset(chartData));
        }
    }

    private async Task HandleRedraw<TDataSet, TItem, TOptions, TModel>(Blazorise.Charts.BaseChart<TDataSet, TItem, TOptions, TModel> chart, Func<TDataSet> getDataSet)
       where TDataSet : ChartDataset<TItem>
       where TOptions : ChartOptions
       where TModel : ChartModel
    {
        if (chart != null)
        {
            await chart.Clear();
            await chart.AddLabelsDatasetsAndUpdate(Labels, getDataSet());
        }
    }

    private PieChartDataset<double> GetPieChartDataset()
    {
        return new()
            {
                Data = new() { transactingCount, noTransactingCount },
                BackgroundColor = backgroundColorsPie,
                BorderColor = borderColorsPie,
                BorderWidth = 1
            };
    }
}
