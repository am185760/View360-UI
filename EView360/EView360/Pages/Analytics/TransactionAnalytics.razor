    public List<double> GetChartData(List<TransactionAnalyticsViewModel> transactionAnalytics)
    {
        List<double> transacrionValues = new();
        float maxFloat = -1;

        foreach (var transaction in transactionAnalytics.OrderBy(x => x.Hr).ToList())
        {
            float dataVal = float.Parse(transaction.Counter.ToString());
            if (dataVal > 0)
            {
                transacrionValues.Add(Math.Round(dataVal, 2));

                if (maxFloat < dataVal)
                    maxFloat = dataVal;
            }
        }
        return transacrionValues;
    }
