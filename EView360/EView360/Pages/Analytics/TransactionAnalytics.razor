@page "/TransactionAnalytics"
@using Blazorise.LoadingIndicator;
@using EView360.Common;
@using EView360.Services.Analytics;
@using EView360.Services;
@using EView360Models.Core;
@using EView360Models.ViewModels;
@using global::Common.ViewModel;
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ILogger<TransactionAnalytics> logger
@inject TransactionAnalyticsService service
@inject CommonServices common;
@inject IJSRuntime jsRuntime
@inject ATMTreeViewRepository atmRepository
@inject NotifyService notifyService
@implements IDisposable

<div class="row content">
    <div class="col-sm-2 filter_bar border-right-2">
        <form style="margin-top: 20px;">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <h5>Filters: </h5>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>From Date: </label>
                    <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Select Date" @bind-Date="@fromDate"></DatePicker>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>To Date: </label>
                    <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Select Date" @bind-Date="@toDate"></DatePicker>

                </div>
            </div>
            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@FilterSubmit" value="Search">
            <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@ResetFilter" value="Reset">

        </form>
    </div>
    <div class="col-sm-10 text-left content_body" style="margin-top:1%">
        <div>
            <b><h2 style="font-family:montserrat; font-weight:bold">Transaction Analysis</h2></b>
        </div>
        <div class="container" style="margin-top:2%; max-width:100% !important;">
            <div class="row">
                <div class="col-sm">
                    <LoadingIndicator @ref="forTodaysDurationGridRepLoader">
                        <div class="card mb-5">
                            <h5 class="card-header">ATM Transaction for today</h5>
                            <h6 class="card-header">Today [@DateTime.Now.ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showTodysChart)
                                {
                                    <div class="mb-2">
                                        <Chart @ref="ChartToday" TItem="double" Options="@chartOptions" />
                                    </div>
                                }

                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
                <div class="col-sm">
                    <LoadingIndicator @ref="lastWeekRepLoader">
                        <div class="card mb-5">
                            <h5 class="card-header">ATM Transaction for last week</h5>
                            <h6 class="card-header">Last Week [@DateTime.Today.AddDays(-7).ToString("dd/MM/yyyy") - @DateTime.Today.AddDays(-1).ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showLastWeekChart)
                                {
                                    <div class="mb-2">
                                        <Chart @ref="ChartLastWeek" TItem="double" Options="@chartOptions" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
            </div>
            <div class="row">
                <div class="col-sm">
                    <LoadingIndicator @ref="specifiedDurationChartRepLoader">

                        <div class="card mb-5">
                            <h5 class="card-header">ATM Transaction for specified duration</h5>
                            <h6 class="card-header">Selection Criteria [@fromDate.ToString("dd/MM/yyyy") - @toDate.ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showSpeficDuarationChart)
                                {
                                    <div class="mb-2">
                                        <Chart @ref="ChartDuration" TItem="double" Options="@chartOptions" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
                <div class="col-sm">
                    <LoadingIndicator @ref="previousWeekRepLoader">
                        <div class="card mb-5">
                            <h5 class="card-header">ATM Transaction for previous week</h5>
                            <h6 class="card-header">Previous Week [@DateTime.Today.AddDays(-14).ToString("dd/MM/yyyy") - @DateTime.Today.AddDays(-8).ToString("dd/MM/yyyy")]</h6>
                            <div class="card-body">
                                @if (showPreviousWeekChart)
                                {
                                    <div class="mb-2">
                                        <Chart @ref="ChartPreviousWeek" TItem="double" Options="@chartOptions" />
                                    </div>
                                }
                            </div>
                        </div>
                    </LoadingIndicator>
                </div>
            </div>
        </div>
    </div>
</div>

<style>



    .btn-danger {
        margin-left: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }

    .content_body {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
    }
</style>


@code {
