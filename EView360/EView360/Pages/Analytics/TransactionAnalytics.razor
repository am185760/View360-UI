    public async void HandleTodaysTransactionChart()
    {
        transactionForToday = await service.GetTransactiomAnalytics(DateTime.Today, DateTime.Today);
        showTodysChart = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();
        await HandleRedraw(ChartToday, GetChartLabel(transactionForToday), GetChartData(transactionForToday));
        await forTodaysDurationGridRepLoader.Hide();
    }

    public async void HandleForDurationTransactionChart()
    {
        transactionForDuration = await service.GetTransactiomAnalytics(fromDate, toDate);
        showSpeficDuarationChart = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

        await HandleRedraw(ChartDuration, GetChartLabel(transactionForDuration), GetChartData(transactionForDuration));
        await specifiedDurationChartRepLoader.Hide();
    }

    public async void HandleForLastWeekTransactionChart()
    {
        transactionForLastWeek = await service.GetTransactiomAnalytics(DateTime.Today.AddDays(-7), DateTime.Today.AddDays(-1));
        showLastWeekChart = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

        await HandleRedraw(ChartLastWeek, GetChartLabel(transactionForLastWeek), GetChartData(transactionForLastWeek));
        await lastWeekRepLoader.Hide();

    }

    public async void HandleForPreviousWeekTransactionChart()
    {
        transactionForPreviousWeek = await service.GetTransactiomAnalytics(DateTime.Today.AddDays(-14), DateTime.Today.AddDays(-8));
        showPreviousWeekChart = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

        await HandleRedraw(ChartPreviousWeek, GetChartLabel(transactionForPreviousWeek), GetChartData(transactionForPreviousWeek));
        await previousWeekRepLoader.Hide();
    }

    public List<string> GetChartLabel(List<TransactionAnalyticsViewModel> transactionAnalytics)
    {
        List<string> Labels = new();

        foreach (var transaction in transactionAnalytics.OrderBy(x => x.Hr).ToList())
        {
            if (float.Parse(transaction.Counter.ToString()) > 0)
            {
                Labels.Add(transaction.Hr.ToString());
            }
        }
        return Labels;
    }

    BarChartDataset<double> GetChartDataset(List<double> chartData)
    {
        return new BarChartDataset<double>
            {
                Label = "Transaction",
                Data = chartData,
                BackgroundColor = backgroundColors,
                BorderColor = borderColors,
                MinBarLength = 10
                //Fill = true,
                //PointRadius = 3,
                //CubicInterpolationMode = "monotone",
            };
    }

    private async void ResetFilter()
    {
        fromDate = DateTime.Now.Date.AddDays(-1);
        toDate = DateTime.Now.Date;
        await this.InvokeAsync(() => this.StateHasChanged());
    }


    async Task HandleRedraw(Chart<double>? Chart, List<string> labels, List<double> chartData)
    {
        if (Chart != null)
        {
            await Chart.Clear();
            await Chart.AddLabelsDatasetsAndUpdate(labels, GetChartDataset(chartData));
        }
        //await Chart?.Clear();

        //await Chart?.AddLabelsDatasetsAndUpdate(labels, GetChartDataset(chartData));
    }

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
        fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
        toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 59);
        notifyService.OnAtmChange += AtmSelected;
        notifyService.OnRegionChange += AtmSelected;
        this.InvokeAsync(() => this.StateHasChanged());
    }
    public void Dispose()
    {
        notifyService.OnAtmChange -= AtmSelected;
        notifyService.OnRegionChange -= AtmSelected;
    }

    private void AtmSelected()
    {
        LoadData();
    }
}
