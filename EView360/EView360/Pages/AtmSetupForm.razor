@page "/AtmSetupForm"
@using EView360.Services;
@using EView360Models.Core;
@using EView360Models.ViewModels;
@using Newtonsoft.Json;
@using static EView360.Common.Constants;
@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime jsRuntime
@inject ILogger<AtmSetupForm> logger
@inject AtmSetupService service
@inject INotificationService NotificationService
@inject ATMTreeViewRepository atmRepository
@inject NotifyService notifyService

@if (showSpinner)
{
    <div class="spinner" style="z-index:4"></div>
}

<Tabs RenderMode="TabsRenderMode.LazyLoad" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
    <Items>
        <Tab Name="General">General Configuration</Tab>
        <Tab Name="Physical">ATM Physical Cassette Configuration</Tab>
        <Tab Name="CashDeposite">Cash Deposite Module Configuration</Tab>
        @*<Tab Name="ChequeDeposite">Cheque Deposite Module Configuration</Tab>*@


    </Items>
    <Content>
        <TabPanel Name="General">
            <br>


            <EditForm EditContext="editContext" OnValidSubmit=@SubmitHandler id="AtmForm">
                <DataAnnotationsValidator />
                <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                <div class="row content">
                    <div class="col-sm-6 sidenav border-right-2">

                        <table class="table-borderless">
                            <div>
                                <h5 class="card-title" style="font-weight:bold">Select parent region from tree</h5>
                            </div>

                            <tbody>
                                @*<tr>
                                <td>Region </td>
                                <td <label class="disabled" @bind="selectedTreeRegion" />@selectedTreeRegion</td>
                                </tr>*@
                                <tr>
                                    <td><i class="fa fa-asterisk" aria-hidden="true" style="font-size:xx-small;vertical-align:top; color:red"></i> ATM ID </td>
                                    <td <InputText class="form-control" @bind-Value="thisAtm.Title" maxlength="8" /></td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-asterisk" aria-hidden="true" style="font-size:xx-small;vertical-align:top; color:red"></i> IP </td>
                                    <td <InputText class="form-control" @bind-Value="thisAtm.Ip" /></td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-asterisk" aria-hidden="true" style="font-size:xx-small;vertical-align:top; color:red"></i> Vendor Type</td>
                                    <td
                                        <Select TValue="string" @bind-SelectedValue="@thisAtm.AtmType" class="form-control">
                                            <SelectItem Disabled>Select</SelectItem>
                                            @foreach (var vendor in vendors.Select(x => new { x.Name }).ToList().Distinct())
                                            {
                                                                    <SelectItem Value="@vendor.Name">@vendor.Name</SelectItem>
                                            }
                                        </Select>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Status</td>
                                    <td>
                                        <RadioGroup TValue="bool" Name="Status" @bind-CheckedValue="@thisAtm.IsActive">
                                            <Radio Value=true>Active</Radio>
                                            <Radio Value=false>Inactive</Radio>
                                        </RadioGroup>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ATM Type</td>
                                    <td>
                                        <div>
                                            <Field Horizontal>
                                                <FieldLabel ColumnSize="ColumnSize.Is3"><Check TValue="bool?" @bind-Checked="@thisAtm.IsAtm">Atm</Check></FieldLabel>
                                                <FieldLabel ColumnSize="ColumnSize.Is3"><Check TValue="bool?" @bind-Checked="@thisAtm.IsCdm">BNA</Check></FieldLabel>
                                                @*<FieldLabel ColumnSize="ColumnSize.Is3"><Check TValue="bool?" @bind-Checked="@thisAtm.IsCcdm">CPM</Check></FieldLabel>*@
                                                @*<Check TValue="bool" @bind-Checked="@thisAtm.IsSdm">SDM</Check>*@
                                            </Field>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-asterisk" aria-hidden="true" style="font-size:xx-small;vertical-align:top; color:red"></i> Note Set Type ID</td>
                                    <td>
                                        <Select TValue="long" SelectedValue="@thisAtm.NoteSetTypeId" class="form-control" SelectedValueChanged="@LoadNoteSetType">
                                            <SelectItem Value="-1" Disabled>Select</SelectItem>
                                            @foreach (var noteset in noteSetTypes.Select(x => new { x.NoteSetTypeId, x.NoteSetTypeName }).ToList().Distinct())
                                            {
                                                <SelectItem Value="@noteset.NoteSetTypeId">@noteset.NoteSetTypeName</SelectItem>
                                            }
                                        </Select>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Location</td>
                                    <td <InputText class="form-control" @bind-Value="thisAtm.Location" /></td>
                                </tr>
                                <tr>
                                    <td>Recycler</td>
                                    <td <Check TValue="bool?" Checked="@thisAtm.IsRecycler" CheckedChanged="@OnRecyclerCheckChanged"></Check></td>
                                </tr>

                                @if (thisAtm.IsRecycler == true)
                                {
                                    <tr>
                                        <td>Physical Towers</td>
                                        <RadioGroup TValue="NumberOfTower" Name="Physical Towers" CheckedValue="recylerTower" CheckedValueChanged="@OnRecyclerTowerChanged">
                                            <Radio Value=NumberOfTower.OneTower>1-Tower</Radio>
                                            <Radio Value=NumberOfTower.TwoTower>2-Tower</Radio>
                                        </RadioGroup>
                                    </tr>


                                    @* 1-Tower *@
                                    @if (this.recylerTower == NumberOfTower.OneTower)
                                    {
                                        <tr>
                                            <td>Machine Type</td>
                                            <RadioGroup TValue="RecyclerType" Name="Machine Type" CheckedValue="@recyclerType" CheckedValueChanged="@OnRecyclerTypeChanged">
                                                <Radio Value="@(RecyclerType.ScalableRecycler)">Scalable Recyler</Radio>
                                                <Radio Value="@(RecyclerType.BRM)">BRM</Radio>
                                            </RadioGroup>
                                            @* <Check TValue="bool" @bind-Checked="@thisAtm.IsScalableRecycler">Scalable Recyler</Check> *@
                                        </tr>
                                    }

                                    @* 2-Tower *@
                                    @if (this.recylerTower == NumberOfTower.TwoTower)
                                    {
                                        <tr>
                                            <td>Machine Type</td>
                                            <RadioGroup TValue="RecyclerType" Name="Machine Type" CheckedValue="@recyclerType" CheckedValueChanged="@OnRecyclerTypeChanged">
                                                <Radio Value="@(RecyclerType.RecyclerAndDispenser)">Recycler & Dispenser</Radio>
                                                <Radio Value="@(RecyclerType.DualDipenser)">Dual Dipenser</Radio>
                                            </RadioGroup>
                                        </tr>
                                    }
                                }

                                @*ask InactivityPeriodNormalDays removed from atm in core*@

                                @*<tr>
                                <td>Allowed Inactivity Period</td>
                                <td <InputNumber class="form-control" @bind-Value="thisAtm.InactivityPeriodNormalDays" /></td>
                                </tr>*@

                                @*<tr>
                                <td>CIT</td>
                                <td <select @bind="thisAtm.CitId" class="form-control">
                                <option Disabled selected>Select</option>
                                @foreach (var cit in cits.Select(x => new { x.CitInternalId, x.Name }).ToList().Distinct())
                                {
                                <option value="@cit.CitInternalId">@cit.Name</option>
                                }
                                </select>
                                </td>
                                </tr>*@
                                @*<tr>
                                <td>Description</td>
                                <td <InputText class="form-control" @bind-Value="thisAtm.Description" /></td>
                                </tr>*@
                                <tr>
                                    <td>Minimun Operating Balance</td>
                                    <td <InputNumber class="form-control" @bind-Value="thisAtm.MinOperatingBalance" /></td>
                                </tr>
                                <tr>
                                    <td>Out Of Cash Threshold</td>
                                    <td <InputNumber class="form-control" @bind-Value="thisAtm.OutOfCashThreshold" /></td>
                                </tr>
                                @if (@isEdit)
                                {
                                    <tr>
                                        <td>Message Processor ID</td>
                                        <td> <InputNumber class="form-control" @bind-Value="thisAtm.MessageProcessorId" readonly /></td>
                                    </tr>
                                    <tr>
                                        <td>Assigned Server</td>
                                        <td> <InputNumber class="form-control" @bind-Value="thisAtm.AssignedServer" readonly /></td>
                                    </tr>
                                }


                            </tbody>
                        </table>
                    </div>

                    <div class="col-sm-6 sidenav nav-scrollable">

                        <table class="table">
                            @*<div>
                            <h5 class="card-title" style="font-weight:bold;align-content:center">Configure job retries</h5>
                            </div>*@
                            <tbody>
                                <tr>

                                    <td>
                                        <h6>Assigned Users</h6>
                                        <Switch TValue="bool" Style="margin-top: 2%" Checked="@toggle" CheckedChanged="@AllCheckChanged">Select All</Switch>
                                        <ul class="list-group list-scroll">
                                            @foreach (var x in @assignedUsers)
                                            {
                                                <li class="list-group-item">
                                                    @if (@x.UserId == @userId)
                                                    {
                                                        x.isSelected = true;
                                                        <Check TValue="bool" @bind-Checked="x.isSelected" Disabled>@x.UserFullName</Check>
                                                    }
                                                    else
                                                    {
                                                        <Check TValue="bool" @bind-Checked="x.isSelected">@x.UserFullName</Check>
                                                    }

                                                </li>
                                            }
                                        </ul>

                                    </td>
                                </tr>
                                @*ask RetryCountAlert removed from atm in core*@
                                @*<tr>
                                <td>Number of retry for sending alert</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountAlert" /></td>

                                </tr>
                                @*<tr>
                                <td>Number of retry for Cash Order Upload</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountCashOrderUpload" /></td>

                                </tr>*@
                                @*<tr>
                                <td>Number of retry for Uploading Configuration</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountConfUpload" /></td>

                                </tr>*@
                                @*ask RetryCountCounterFile removed from atm in core*@
                                @*<tr>
                                <td>Number of retry for Downloading Counter File</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountCounterFile" /></td>

                                </tr>*@
                                @*<tr>
                                <td>Number of retry for Executing Restart Schedule</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountRestartSchedule" /></td>

                                </tr>
                                <tr>
                                <td>Number of retry for Executing DateTime Synce Schedule</td>
                                <td<InputNumber class="form-control" @bind-Value="thisAtm.RetryCountDatetimeSchedule" /></td>

                                </tr>*@
                            </tbody>
                        </table>
                    </div>
                </div>
            </EditForm>


            <div class="modal-footer">
                <input type="submit" form="AtmForm" class="btn btn-success" value="Save" />
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="@OnCancelCallback">Close</button>
            </div>
        </TabPanel>
