</style>
@code {
    private EView360Models.Core.AppUser appUser;
    private DotNetObjectReference<AtmSetupForm>? objRef;
    private RecyclerType recyclerType;
    private NumberOfTower recylerTower;

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    string selectedTab = "General";
    private bool toggle = false;
    //private string beforeEditTitle = string.Empty;
    private bool showSpinner = false;

    [Parameter] public EView360Models.Core.Atm thisAtm { get; set; }
    [Parameter] public EventCallback<EView360Models.Core.Atm> OnSubmitCallback { get; set; }
    [Parameter] public EventCallback<EView360Models.Core.Atm> OnCancelCallback { get; set; }
    [Parameter] public List<EView360Models.Core.Atm> atms { get; set; }
    [Parameter] public bool isEdit { get; set; }
    [Parameter] public long? selectedTreeRegion { get; set; }
    //[Parameter] public List<EView360Models.Core.Cit> cits { get; set; }
    [Parameter] public List<EView360Models.Core.NoteSetType> noteSetTypes { get; set; }
    [Parameter] public List<EView360Models.Core.AppUser> assignedUsers { get; set; }
    [Parameter] public long userId { get; set; }
    [Parameter] public List<TerminalType> vendors { get; set; }


    protected override void OnInitialized()
    {
        if (!isEdit)
        {
            AllCheckChanged(true);
        }
        else
        {
            if (assignedUsers.All(x => x.isSelected) == true)
            {
                toggle = true;
            }

            if (thisAtm.IsRecycler==true && thisAtm.RecyclerType != null && thisAtm.RecyclerTower != null)
            {
                this.recyclerType = (RecyclerType)Enum.Parse(typeof(RecyclerType), thisAtm.RecyclerType);
                this.recylerTower = (NumberOfTower)Enum.Parse(typeof(NumberOfTower), thisAtm.RecyclerTower);
            }
        }
        editContext = new(thisAtm);
        editContext.OnValidationRequested += CustomValidations;
        messageStore = new(editContext);
        objRef = DotNetObjectReference.Create(this);
        LoadNoteSetType(thisAtm.NoteSetTypeId);
    }

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    private async void GetLocalStorageData()
    {
        selectedTreeRegion = await atmRepository.GetSelectedRegionId();
    }

    private void CustomValidations(object? sender, ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
        List<EView360Models.Core.Atm> ValidationAtms = atms;
        if (isEdit)
            ValidationAtms.Remove(ValidationAtms.FirstOrDefault(x => x.AtmId == thisAtm.AtmId));

        if (ValidationAtms.Any(x => x.Title.Trim().ToLower() == thisAtm.Title?.Trim()?.ToLower()))
            messageStore?.Add(() => thisAtm.Title, "ATM with same name already exists. Please provide unique name");

        if (ValidationAtms.Any(x => x.Ip == thisAtm.Ip))
            messageStore?.Add(() => thisAtm.Ip, "ATM with same IP already exists. Please provide unique IP");

        if (selectedTreeRegion == null || selectedTreeRegion == 1)
            messageStore?.Add(() => selectedTreeRegion, "Please select a valid region from tree");

        if (thisAtm.NoteSetTypeId == -1)
            messageStore?.Add(() => thisAtm.NoteSetTypeId, "Please select a Note Set ID");

        if (string.IsNullOrEmpty(thisAtm.AtmType))
            messageStore?.Add(() => thisAtm.AtmType, "Please select a vendor type");
    }

    private async Task SubmitHandler()
    {
        try
        {
            showSpinner = true;
            thisAtm.RegionId = selectedTreeRegion;


            if (isEdit)
            {
                string response = string.Empty;
                if (thisAtm.RetryCountCounterFile is null)
                    thisAtm.RetryCountCounterFile = 10;

                response = await service.UpdateAtm(thisAtm);
                if (response == "success")
                {
                    //update tree AtmList & notify
                    if (!thisAtm.IsActive)
                    {
                        await jsRuntime.InvokeVoidAsync("DeleteNode", objRef, "a" + thisAtm.AtmId.ToString());
                        atmRepository.SelectedAtmIds.Remove(thisAtm.AtmId);
                        atmRepository.AtmList.Remove(atmRepository.AtmList.FirstOrDefault(x => x.AtmId == thisAtm.AtmId));
                    }
                    else
                    {
                        await jsRuntime.InvokeVoidAsync("UpdateNode", objRef, 'r' + selectedTreeRegion.ToString(), 'a' + thisAtm.AtmId.ToString(), thisAtm.Title);
                        string jsonAtm = JsonConvert.SerializeObject(thisAtm);
                        AtmViewModel atmViewModel = JsonConvert.DeserializeObject<AtmViewModel>(jsonAtm);
                        atmRepository.AtmList.Remove(atmRepository.AtmList.FirstOrDefault(x => x.AtmId == thisAtm.AtmId));
                        atmRepository.AtmList.Add(atmViewModel);
                    }
                    await notifyService.NotifySearchListChanged();

                    response = await service.UpdateAtmUsers(assignedUsers, thisAtm.AtmId);

                    if (response == "success")
                    {
                        await service.RenderSuccessBox("Successfully Updated", "Atm has been successfully updated");

                        await OnSubmitCallback.InvokeAsync(thisAtm);
                    }
                }
                else
                {
                    showSpinner = false;
                    await NotificationService.Error(response, "Error", (options) =>
                    {
                        options.IntervalBeforeClose = 4000;
                    });
                }
            }
            else
            {
                string[] response;
                EView360Models.Core.AppUser user = await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser");
                thisAtm.CreatedBy = user.UserId;
                thisAtm.CreationTime = DateTime.Now;
                thisAtm.IsHealthy = true;
                thisAtm.RetryCountCounterFile = 10;
                thisAtm.IsSwapDefaultReplenishment = false;
                response = await service.InsertAtm(thisAtm);
                thisAtm.AtmId = Int64.Parse(response[1]);

                if (response[0] == "success")
                {
                    await jsRuntime.InvokeVoidAsync("CreateNode", objRef, 'r' + selectedTreeRegion.ToString(), 'a' + thisAtm.AtmId.ToString(), thisAtm.Title);

                    //Add Atm to tree AtmList & notify
                    atmRepository.AtmList.Add(new EView360Models.ViewModels.AtmViewModel()
                        {
                            AtmId = thisAtm.AtmId,
                            Ip = thisAtm.Ip,
                            IsCdm = thisAtm.IsCdm,
                            IsHealthy = thisAtm.IsHealthy,
                            Location = thisAtm.Location,
                            MinOperatingBalance = thisAtm.MinOperatingBalance,
                            NoteSetTypeId = thisAtm.NoteSetTypeId,
                            RegionId = thisAtm.RegionId,
                            Title = thisAtm.Title
                        });
                    await notifyService.NotifySearchListChanged();

                    await service.UpdateAtmUsers(assignedUsers, thisAtm.AtmId);
                    await OnSubmitCallback.InvokeAsync(thisAtm);
                }
                else
                {
                    isEdit = true;
                    showSpinner = false;
                    await NotificationService.Error(response[0], "Error", (options) =>
                    {
                        options.IntervalBeforeClose = 4000;
                    });
                }
            }
        }
        catch (Exception ex)
        {
            showSpinner = false;
            logger.LogError($"Exception at AtmSetup, SubmitHandler as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }


    public void Dispose()
    {
        objRef?.Dispose();
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= CustomValidations;
        }
    }

    void OnRecyclerCheckChanged(bool? isRecycler)
    {
        thisAtm.IsRecycler = isRecycler;
        if (isRecycler!= null  && isRecycler==true)
        {
            OnRecyclerTowerChanged(NumberOfTower.OneTower);
        }
        else
        {
            thisAtm.RecyclerTower = null;
            thisAtm.RecyclerType = null;
        }
    }

    void OnRecyclerTowerChanged(NumberOfTower recyclerTower)
    {
        this.recylerTower = recyclerTower;
        thisAtm.RecyclerTower = Enum.GetName(this.recylerTower);
        if (recyclerTower == NumberOfTower.OneTower)
        {
            recyclerType = RecyclerType.ScalableRecycler;
            thisAtm.RecyclerType = Enum.GetName(recyclerType);
        }
        else
        {
            recyclerType = RecyclerType.RecyclerAndDispenser;
            thisAtm.RecyclerType = Enum.GetName(recyclerType);
        }
    }

    void OnRecyclerTypeChanged(RecyclerType recyclerType)
    {
        this.recyclerType = recyclerType;
        thisAtm.RecyclerType = Enum.GetName(this.recyclerType);
    }

    Task LoadNoteSetType(long value)
    {
        thisAtm.NoteSetTypeId = value;

        if (thisAtm.NoteSetTypeId == -1)
            return Task.CompletedTask;

        EView360Models.Core.NoteSetType noteSetType = noteSetTypes.Where(x => x.NoteSetTypeId == thisAtm.NoteSetTypeId).FirstOrDefault();
        if (noteSetType.DenominationType1Title != null)
        {
            thisAtm.Cassette1Denomination = (int)noteSetType.DenominationType1;
            thisAtm.Cassette1Capacity = 2000;
            thisAtm.Purge1Threshold = 10;
            thisAtm.IsPurge1ThresholdSelected = true;
        }
        if (noteSetType.DenominationType2Title != null)
        {
            thisAtm.Cassette2Denomination = (int)noteSetType.DenominationType2;
            thisAtm.Cassette2Capacity = 2000;
            thisAtm.Purge2Threshold = 10;
            thisAtm.IsPurge2ThresholdSelected = true;
        }
        if (noteSetType.DenominationType3Title != null)
        {
            thisAtm.Cassette3Denomination = (int)noteSetType.DenominationType3;
            thisAtm.Cassette3Capacity = 2000;
            thisAtm.Purge3Threshold = 10;
            thisAtm.IsPurge3ThresholdSelected = true;
        }
        if (noteSetType.DenominationType4Title != null)
        {
            thisAtm.Cassette4Denomination = (int)noteSetType.DenominationType4;
            thisAtm.Cassette4Capacity = 2000;
            thisAtm.Purge4Threshold = 10;
            thisAtm.IsPurge4ThresholdSelected = true;
        }
        if (noteSetType.DenominationType5Title != null)
        {
            thisAtm.Cassette5Denomination = (int)noteSetType.DenominationType5;
            thisAtm.Cassette5Capacity = 2000;
            thisAtm.Purge5Threshold = 10;
            thisAtm.IsPurge5ThresholdSelected = true;
        }
        if (noteSetType.DenominationType6Title != null)
        {
            thisAtm.Cassette6Denomination = (int)noteSetType.DenominationType6;
            thisAtm.Cassette6Capacity = 2000;
            thisAtm.Purge6Threshold = 10;
            thisAtm.IsPurge6ThresholdSelected = true;
        }
        if (noteSetType.DenominationType7Title != null)
        {
            thisAtm.Cassette7Denomination = (int)noteSetType.DenominationType7;
            thisAtm.Cassette7Capacity = 2000;
            thisAtm.Purge7Threshold = 10;
            thisAtm.IsPurge7ThresholdSelected = true;
        }
        return Task.CompletedTask;
    }

    private void AllCheckChanged(bool value)
    {
        toggle = value;

        if (value)
        {
            assignedUsers.Where(x => x.UserId != userId).Select(x => { x.isSelected = true; return x; }).ToList();
        }
        else
        {
            assignedUsers.Where(x => x.UserId != userId).Select(x => { x.isSelected = false; return x; }).ToList();
        }
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private void ChangeToggle()
    {
        if (assignedUsers.All(x => x.isSelected) == true)
        {
            toggle = true;
        }
        else
        {
            toggle = false;
        }
    }
}