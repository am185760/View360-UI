        <TabPanel Name="CashDeposite">
            <EditForm EditContext="editContext" OnValidSubmit=@SubmitHandler id="AtmForm">
                <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

                <table class="table">
                    <thead>
                    <th></th>
                    <th style="position: relative; right: 250px">Capacity</th>
                    <th style="position: relative; right: 440px">Threshold</th>
                    </thead>
                    <tbody>
                        <tr>
                            <td><b>Cassette 1</b></td>
                            <td>
                                <div class="form-group">
                                    <InputNumber class="form-control postion-adjustment-capacity" @bind-Value="thisAtm.CdmCassette1Capacity" />
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <InputNumber class="form-control postion-adjustment-threshold" @bind-Value="thisAtm.CdmCassette1Threshold" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Cassette 2</b></td>
