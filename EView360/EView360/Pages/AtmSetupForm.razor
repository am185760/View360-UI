                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <InputNumber class="form-control small-width" @bind-Value="thisAtm.Cassette3Capacity" />
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <Field Horizontal>
