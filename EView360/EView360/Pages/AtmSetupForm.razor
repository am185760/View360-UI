                </table>
            </EditForm>
            <div class="modal-footer">
                <input type="submit" form="AtmForm" class="btn btn-success" value="Save" />
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="@OnCancelCallback">Close</button>
            </div>
        </TabPanel>

        <TabPanel Name="ChequeDeposite">
            <EditForm EditContext="editContext" OnValidSubmit=@SubmitHandler id="AtmForm">
                <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

                <table class="table">
                    <thead>
