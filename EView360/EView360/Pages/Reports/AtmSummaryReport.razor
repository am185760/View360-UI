@page "/AtmSummaryReport"
@page "/AtmSummaryReport/{mode}"

@using DataRequestor;
@using DataRequestorMiddleware.Services.Reports;
@using EView360.Common;
@using EView360.Services.Reports;
@using EView360.Services;
@using Microsoft.Extensions.Caching.Distributed;
@using Microsoft.Extensions.Options;
@using Newtonsoft.Json;
@using EView360.Data;
@using System.Text;
@using global::Common.RequestModel;
@using global::Common.ViewModel;
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ILogger<AtmSummaryReport> logger
@inject AtmService atmService
@inject IJSRuntime jsRuntime
@inject IOptions<ApiUrl> apiUrl
@inject HttpClient client
@inject CommonServices common;
@inject OutOfCashReportService service
@inject AtmSummaryReportService reportService;
@inject AtmSetupService AtmService
@inject UserManagementService userService
@inject ATMTreeViewRepository treeService;
@inject IDistributedCache _distributedCache


<div class="row content">
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }
    <div class="col-sm-12">
        <div class="form-group">
            <b><h2 style="font-family:montserrat; font-weight:bold; margin-top: 1%;">Atm Summary Report @(isArchive ? "- Archive" : "")</h2></b>
        </div>
        <div class="card" style="border-width: medium;border-color: orange; margin-top:2%;">
            <div class="card-body">
                <form style="margin-top: 20px;">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <h5>Filters: </h5>
                        </div>
                    </div>
                    @if (@mode is not null && mode.Equals("Archive"))
                    {
                        <div class="form-row">
                            <div class="form-group col-md-1">
                                <label>Archive Year: </label>
                            </div>
                            <div class="form-group col-md-2">
                                <Select TValue="int" SelectedValue="archiveYear" class="form-control" SelectedValueChanged="@OnArchiveYearChange">
                                    @foreach (int year in archiveYears)
                                    {
                                        <SelectItem Value=year>@year</SelectItem>
                                    }
                                </Select>
                            </div>
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>From Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            @if (isArchive)
                            {
                                <DatePicker TValue="DateTime?" @bind-Date="@filter.FromDate" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" class="form-control" @oninput="ChangeToArchiveYear" />
                            }
                            else
                            {
                                <DatePicker TValue="DateTime?" @bind-Date="@filter.FromDate" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" class="form-control" />
                            }
                        </div>
                        <div class="form-group col-md-4 text-right">
                            <label>To Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            @if (isArchive)
                            {
                                <DatePicker TValue="DateTime?" @bind-Date="@filter.ToDate" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" class="form-control" @oninput="ChangeToArchiveYear" />
                            }
                            else
                            {
                                <DatePicker TValue="DateTime?" @bind-Date="@filter.ToDate" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" class="form-control" />
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>Created By: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <select @bind="filter.CreatedBy" class="form-control">
                                <option value="*">Any</option>
                                @foreach (var user in createdBy.Distinct())
                                {
                                    <option value="@user.UserId.ToString()">@user.UserLogin</option>
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-4 text-right">
                            <label>Status: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <select @bind="filter.Status" class="form-control">
                                @foreach (var currentStatus in status)
                                {
                                    <option value="@currentStatus">@currentStatus</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>ATM Type: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <select @bind="filter.AtmType" class="form-control">
                                <option value="*">Any</option>
                                @foreach (var atmType in atmTypes.Distinct())
                                {
                                    <option value="@atmType">@atmType</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-4 text-right">
                            <label>Group: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <ListView TItem="NoteSetTypeViewModel"
                                      Data="noteSetTypes"
                                      TextField="(item) => item.NoteSetTypeName"
                                      ValueField="(item) => item.NoteSetTypeId.ToString()"
                                      Mode="ListGroupMode.Static"
                                      MaxHeight="200px"
                                      Style="margin-top: 2%">
                                <ItemTemplate>
                                    <Check TValue="bool" @bind-Checked="context.Item.isSelected">@context.Text</Check>
                                </ItemTemplate>
                            </ListView>
                        </div>
                    </div>



                    <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@FilterSubmit" value="Generate Report">
                    <input class="btn btn-success" disabled="@IsDisabled" type="button" onclick="@ResetFilter" value="Reset">

                </form>

            </div>
        </div>
    </div>



</div>


<style>

    form {
        max-width: 100%;
    }

    .btn-danger {
        margin-left: 5px;
    }

    .all_headers_form {
        margin-left: 12px;
        padding: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }

</style>

@if (@mode is not null)
{
    <style>
        .flatpickr-prev-month, .flatpickr-month .numInputWrapper, .flatpickr-next-month {
            visibility: hidden;
        }

        .flatpickr-month {
            font-size: large;
        }
    </style>
}

@code {
    private int archiveYear;
    static DateTime currentTime = DateTime.Now;
    private AtmSummaryReportViewModel filter = new AtmSummaryReportViewModel()
        {
            FromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0),
            ToDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0)
        };
    private bool filteredIsCurrent = false;
    private List<NoteSetTypeViewModel>? noteSetTypes = new();
    private List<EView360Models.ViewModels.AppUserDropdownViewModel> createdBy = new();
    private List<string> status = new List<string> { "Any", "Active", "Inactive" };
    private List<string> atmTypes = new();
    private DotNetObjectReference<AtmSummaryReport>? objRef;

    [Parameter]
    public string? mode { get; set; }
    private List<int> archiveYears = new();
    bool isArchive = false;
    bool showSpinner = false;
    bool IsDisabled = false;
    string userLogin = string.Empty;

    [Inject] INotificationService? NotificationService { get; set; }

    protected async override void OnParametersSet()
    {
        if (mode is not null && mode.Equals("Archive"))
        {
            isArchive = true;
            archiveYears = common.GetLastNYears();
            archiveYear = archiveYears.FirstOrDefault();
            filter.ToDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
            filter.FromDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
            
        }
        else
        {
            archiveYear = 0;
            filter.FromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
            filter.ToDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
        }
        filter.Status = "Any";
        filter.CreatedBy = "*";
        filter.AtmType = "*";
        filter.UserId = (await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser")).UserId;

    }


    protected async override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);

        userLogin = (await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser")).UserLogin;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await jsRuntime.InvokeVoidAsync("handleDatePicker", objRef);

                noteSetTypes = await service.GetNoteSetTypesByUser(filter.UserId);
                atmTypes = (await AtmService.GetAtmTerminalType()).Select(x => x.Name).ToList();
                createdBy = await userService.GetAllUsers();
                this.InvokeAsync(() => this.StateHasChanged());
            }
        }
        catch (Exception ex)
        {
            await service.RenderErrorBox("Error", ex.Message);
            logger.LogError($"Exception at OutOfCashReport, OnAfterRenderAsync as: {ex.Message}");
        }
    }

    private async void FilterSubmit()
    {
        showSpinner = IsDisabled = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

        //var selectAtmResponse = await atmService.GetMultipleSelectedAtms();
        //if (!selectAtmResponse.IsSuccess)
        //{
        //    await NotificationService.Error($"{selectAtmResponse.Message}", "Error", (options) =>
        //    {
        //        options.IntervalBeforeClose = 4000;
        //    });
        //}
        //else
        //{
        //    filter.SelectedAtmIds = ((List<string>)selectAtmResponse.Data);
        (filter.SelectedAtmIds, filter.SelectedRegionIds) = await treeService.GetSelectedAtmOrRegionList();

        filter.NoteSetTypes = noteSetTypes.Where(x => x.isSelected).Select(x => x.NoteSetTypeId).ToList();
        
        logger.LogWarning($"[AtmSummaryReportPage:FilterSubmit] going in GetAtmSummaryReport ");
        DataTableResult dataResult = reportService.GetAtmSummaryReport(filter);
        logger.LogWarning($"[AtmSummaryReportPage:FilterSubmit] returning from GetAtmSummaryReport ");

        if (!string.IsNullOrEmpty(dataResult.ExceptionMessage))
        {
            await common.RenderErrorBox(dataResult.ExceptionMessage);
        }
        if (dataResult.Table.Rows.Count > 0)
        {
            logger.LogWarning("[AtmSummaryReportPage:FilterSubmit] Start Serializing Datatable ");
            string serializedDatatable = JsonConvert.SerializeObject(dataResult.Table);
            logger.LogWarning("[AtmSummaryReportPage:FilterSubmit] End Serializing Datatable ");

            logger.LogWarning("[AtmSummaryReportPage:FilterSubmit] Start convering serialized Datatable into bytes ");
            byte[] bytes = Encoding.ASCII.GetBytes(serializedDatatable);
            logger.LogWarning("[AtmSummaryReportPage:FilterSubmit] End convering serialized Datatable into bytes ");

            string redisKey = $"AtmSummaryReport_{filter.UserId}";
            _distributedCache.Set(redisKey, bytes);

            var reports = new ReportsRequestModel()
                {
                    redisKey = $"{redisKey}",
                };

            string url = $"{apiUrl.Value.ReportingProjectUrl}ReportPopup.aspx?Report=AtmSummaryRpt.rpt&ReportTitle=Atm%20Summary%20Report&FromDate={filter.FromDate.Value.Date.ToString("MM/dd/yyyy")}&ToDate={filter.ToDate.Value.ToString("MM/dd/yyyy")}&GeneratedBy={userLogin}";
            await jsRuntime.InvokeVoidAsync("openWindowWithPost", url, reports);
        }
        else
        {
            await NotificationService.Info("No record found, check filters..", "Information", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
        //}
        showSpinner = IsDisabled = false;
        await this.InvokeAsync(() => this.StateHasChanged());
    }

    private void ResetFilter()
    {
        currentTime = DateTime.Now;

        if (mode is not null && mode.Equals("Archive"))
        {
            archiveYear = archiveYears.FirstOrDefault();
            filter.FromDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
            filter.ToDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
        }
        else
        {
            filter.FromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
            filter.ToDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
            archiveYear = 0;
        }
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private Task OnArchiveYearChange(int selectedYear)
    {
        archiveYear = selectedYear;
        filter.FromDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
        filter.ToDate = new DateTime(archiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
        this.InvokeAsync(() => this.StateHasChanged());
        return Task.CompletedTask;
    }

    private Task ChangeToArchiveYear()
    {
        if (mode is not null && mode.Equals("Archive"))
        {
            if (filter.FromDate != null && filter.FromDate.Value.Year != archiveYear)
                filter.FromDate = new DateTime(archiveYear, filter.FromDate.Value.Month, filter.FromDate.Value.Day, filter.FromDate.Value.Hour, filter.FromDate.Value.Month, filter.FromDate.Value.Second);

            if (filter.ToDate != null && filter.ToDate.Value.Year != archiveYear)
                filter.ToDate = new DateTime(archiveYear, filter.ToDate.Value.Month, filter.ToDate.Value.Day, filter.ToDate.Value.Hour, filter.ToDate.Value.Month, filter.ToDate.Value.Second);
        }
        return Task.CompletedTask;
    }
}
