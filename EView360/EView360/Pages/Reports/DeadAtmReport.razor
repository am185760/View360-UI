@page "/DeadAtmReport"
@page "/DeadAtmReport/{mode}"

@using DataRequestor;
@using DataRequestorMiddleware;
@using EView360.Data;
@using EView360.Services;
@using EView360Models.Core;
@using System.Text;
@using System.Net;
@using Microsoft.Extensions.Caching.Distributed;
@using Microsoft.Extensions.Options;
@using Newtonsoft.Json;
@using System.Data;
@using global::Common.RequestModel;
@inject ILogger<DeadAtmReport> logger
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NoteSetTypeService noteSetTypeService
@inject AtmService atmService
@inject HttpClient client
@inject IJSRuntime jsRuntime
@inject IOptions<ApiUrl> apiUrl
@inject DeadAtmReportService reportService
@inject IDistributedCache _distributedCache
@inject IConfiguration _configuration

<div class="row content">
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }
    <div class="col-sm-12">
        <div class="form-group">
            <b><h2 style="font-family:montserrat; font-weight:bold; margin-top: 1%;">Dead ATM Report @(isArchive ? "- Archive" : "")</h2></b>
        </div>
        <div class="card" style="border-width: medium;border-color: orange; margin-top:3%;">
            <div class="card-body">
                <form style="margin-top: 20px;">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <h5>Filters: </h5>
                        </div>
                    </div>

                    @if (isArchive)
                    {
                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <label>Archive Year: </label>
                                <select class="form-control" @bind="ArchiveYear">
                                    <option value="2022">2022</option>
                                    <option value="2021">2021</option>
                                    <option value="2020">2020</option>
                                    <option value="2019">2019</option>
                                    <option value="2018">2018</option>

                                </select>
                            </div>
                        </div>
                    }

                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>From Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Selete Date" @bind-Date="@fromDate"></DatePicker>
                        </div>
                        <div class="form-group col-md-4 text-right">
                            <label>To Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <DatePicker TValue="DateTime" @ref="@dateRef" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" TimeAs24hr="true" Placeholder="Selete Date" @bind-Date="@toDate"></DatePicker>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label class="float-left">Group :</label>
                        </div>
                        <div class="form-group col-md-2">
                            <select @bind="filterNoteSetTypeBy" class="form-control">
                                <option value="*">Any</option>
                                @if (noteSetType != null)
                                {
                                    @foreach (var noteSetType in noteSetType?.ToList().Distinct())
                                    {
                                        <option value="@noteSetType.NoteSetTypeId">@noteSetType.NoteSetTypeName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <input class="btn btn-success" type="button" onclick="@FilterSubmit" value="Generate Report">
                    <input class="btn btn-success" type="button" onclick="@ResetFilter" value="Reset">
                </form>
            </div>
        </div>
    </div>
</div>


<style>

    form {
        max-width: 100%;
    }

    .btn-danger {
        margin-left: 5px;
    }

    .all_headers_form {
        margin-left: 12px;
        padding: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }

</style>

@code {
    private bool showSpinner = false;
    private bool showGrid = false;
    static DateTime currentTime = DateTime.Now;
    DateTime fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
    DateTime toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
    DatePicker<DateTime>? dateRef;
    private string? filterNoteSetTypeBy = "*";
    int orderId = 0;
    private List<NoteSetType>? noteSetType;
    [Inject] INotificationService NotificationService { get; set; }
    [Inject] IMessageService MessageService { get; set; }
    private AppUser appUser = null;
    private DotNetObjectReference<DeadAtmReport>? objRef;

    //archive
    [Parameter]
    public string? mode { get; set; }
    bool isArchive = false;
    int ArchiveYear = DateTime.Now.Year - 1;

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!string.IsNullOrEmpty(mode) && mode.Equals("Archive"))
            {
                isArchive = true;
            }

            if (firstRender)
            {
                await jsRuntime.InvokeVoidAsync("handleDatePicker", objRef);

                appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
                if (appUser is not null)
                {
                    noteSetTypeService.UserId = appUser.UserId;
                }
                noteSetType = await noteSetTypeService.GetNoteSetTypeListAsync();
                this.InvokeAsync(() => this.StateHasChanged());
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at Dead Atm Report, OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private async void FilterSubmit()
    {
        try
        {
            var selectAtmResponse = await atmService.GetMultipleSelectedAtms();
            if (!selectAtmResponse.IsSuccess)
            {
                await NotificationService.Error($"{selectAtmResponse.Message}", "Error", (options) =>
                {
                    options.IntervalBeforeClose = 4000;
                });
            }
            else
            {
                showSpinner = true;
                this.InvokeAsync(() => this.StateHasChanged());

                await Task.Delay(5);

                var atms = ((List<string>)selectAtmResponse.Data);
                string selectedAtms = string.Join(",", atms);

                DeadAtmRptRequestModel requestModel = new()
                    {
                        FromDate = fromDate,
                        ToDate = toDate,
                        SelectedAtms = atms,
                        SelectedNoteSetType = filterNoteSetTypeBy == "*" ? string.Empty : filterNoteSetTypeBy,
                        archiveYear = isArchive ? ArchiveYear : null
                    };
                logger.LogWarning($"DeadAtmRpt: going in GetDeadAtmReport  : {DateTime.Now.ToString()}");
                DataTableResult dataResult = reportService.GetDeadAtmReport(requestModel);
                logger.LogWarning($"DeadAtmRpt: return from GetDeadAtmReport  : {DateTime.Now.ToString()}");


                showSpinner = false;
                this.InvokeAsync(() => this.StateHasChanged());

                if (!string.IsNullOrEmpty(dataResult.ExceptionMessage))
                {
                    await NotificationService.Error($"{dataResult.ExceptionMessage}", "Error", (options) =>
                    {
                        options.IntervalBeforeClose = 4000;
                    });
                }
                if (dataResult?.Table?.Rows?.Count > 0)
                {
                    dataResult.Table.Columns.Add("organization");

                    logger.LogWarning($"DeadAtmRpt: DataTable's row Count =  : {dataResult.Table.Rows.Count}");

                    logger.LogWarning($"DeadAtmRpt: going to SerializeObject");
                    string value = JsonConvert.SerializeObject(dataResult.Table);
                    logger.LogWarning($"DeadAtmRpt: return from SerializeObject");

                    logger.LogWarning($"DeadAtmRpt: going to Encoding the string");
                    byte[] bytes = Encoding.ASCII.GetBytes(value);
                    logger.LogWarning($"DeadAtmRpt: return from Encoding the string");

                    string redisKey = $"DeadAtmRpt_{appUser.UserId}";

                    logger.LogWarning($"DeadAtmRpt: going to cache the data");
                    _distributedCache.Set(redisKey, bytes, new DistributedCacheEntryOptions()
                        {
                            AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(_configuration.GetValue<int>("RedisKeyExpirationTimeInMinutes"))
                        });
                    logger.LogWarning($"DeadAtmRpt: return from cache the data");


                    var reports = new ReportsRequestModel()
                        {
                            redisKey = redisKey
                        };
                    string url = $"{apiUrl.Value.ReportingProjectUrl}ReportPopup.aspx?Report=DeadATMsReport.rpt&ReportTitle=Dead%20ATM%20Report&FromDate={fromDate.Date.ToString("MM/dd/yyyy")}&ToDate={toDate.Date.ToString("MM/dd/yyyy")}&GeneratedBy={appUser.UserLogin}&userId={appUser.UserId}";

                    logger.LogWarning($"DeadAtmRpt: going in openWindowWithPost  : {DateTime.Now.ToString()}");
                    await jsRuntime.InvokeVoidAsync("openWindowWithPost", url, reports);
                }
                else
                {
                    await NotificationService.Info("No record found, check filters..", "Information", (options) =>
                    {
                        options.IntervalBeforeClose = 4000;
                    });
                }
            }
        }
        catch(Exception ex)
        {
            await NotificationService.Error("Exception came at Submit as: " + ex.Message, "Error", (options) =>
                    {
                        options.IntervalBeforeClose = 4000;
                    });
            logger.LogError("Exception came at DeadAtmReport Submit as: " + ex.Message);
        }
        
    }

    private async void ResetFilter()
    {
        filterNoteSetTypeBy = "*";
        fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
        toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
        this.InvokeAsync(() => this.StateHasChanged());
    }
}

