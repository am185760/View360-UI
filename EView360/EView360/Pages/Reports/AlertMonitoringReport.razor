@page "/AlertMonitoringReport"
@page "/AlertMonitoringReport/{mode}"

@using EView360.Common;
@using EView360.Data;
@using EView360.Services.Operations;
@using EView360.Services;
@using EView360.Services.Reports;
@using EView360Models.RequestModel;
@using Microsoft.Extensions.Caching.Distributed;
@using Microsoft.Extensions.Options;
@using Newtonsoft.Json;
@using System.Text;
@using global::Common.RequestModel;
@inject AlertMonitoringService service;
@inject AlertMonitoringReportService alertService;
@inject ILogger<AlertMonitoringReport> logger
@inject AtmService atmService
@inject IJSRuntime jsRuntime
@inject IOptions<ApiUrl> apiUrl
@inject HttpClient client
@inject CommonServices common;
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IDistributedCache _distributedCache


<div class="row content">
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }

    <div class="col-sm-12">
        <div class="form-group">
            <b><h2 style="font-family:montserrat; font-weight:bold; margin-top: 1%;">Alert Monitoring Report @(isArchive ? "- Archive" : "")</h2></b>
        </div>
        <div class="card" style="border-width: medium;border-color: orange; margin-top:2%;">
            <div class="card-body">
                <form style="margin-top: 20px;">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <h5>Filters: </h5>
                        </div>
                    </div>
                    @if (@mode is not null && mode.Equals("Archive"))
                    {
                        <div class="form-row">
                            <div class="form-group col-md-1">
                                <label>Archive Year: </label>
                            </div>
                            <div class="form-group col-md-2">
                                <Select TValue="int" SelectedValue="filter.ArchiveYear" class="form-control" SelectedValueChanged="@OnArchiveYearChange">
                                    @foreach (int year in archiveYears)
                                    {
                                        <SelectItem Value=year>@year</SelectItem>
                                    }
                                </Select>
                            </div>
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>From Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            @if (!string.IsNullOrEmpty(mode) && mode.Equals("Archive"))
                            {
                                <DatePicker TValue="DateTime?" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" @bind-Date="@filter.fromDate" class="form-control" @oninput="ChangeToArchiveYear" TimeAs24hr="true" />
                            }
                            else
                            {
                                <DatePicker TValue="DateTime?" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" @bind-Date="@filter.fromDate" class="form-control" TimeAs24hr="true" />
                            }
                        </div>
                        <div class="form-group col-md-4 text-right">
                            <label>To Date: </label>
                        </div>
                        <div class="form-group col-md-2">
                            @if (!string.IsNullOrEmpty(mode) && mode.Equals("Archive"))
                            {
                                <DatePicker TValue="DateTime?" DisplayFormat="dd/MM H:m" InputMode="DateInputMode.DateTime" @bind-Date="@filter.toDate" class="form-control" @oninput="ChangeToArchiveYear" TimeAs24hr="true" />
                            }
                            else
                            {
                                <DatePicker TValue="DateTime?" DisplayFormat="dd/MM/yyyy H:m" InputMode="DateInputMode.DateTime" @bind-Date="@filter.toDate" class="form-control" TimeAs24hr="true" />
                            }
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-1">
                            <label>Type: </label>
                        </div>
                        <div class="form-group col-md-2">
                            <select @bind="filter.type" class="form-control">
                                <option value="*">Any</option>
                                @foreach (var alertType in alertTypes.Distinct())
                                {
                                    <option value="@alertType">@alertType</option>
                                }
                            </select>
                        </div>
                    </div>

                    <input class="btn btn-success" type="button" disabled="@IsDisabled" onclick="@FilterSubmit" value="Generate Report">
                    <input class="btn btn-success" type="button" disabled="@IsDisabled" onclick="@ResetFilter" value="Reset">

                </form>
            </div>
        </div>
    </div>
</div>

<style>

    form {
        max-width: 100%;
        width: 100%;
    }

    .table-primary .showAnimation {
        animation: spin 1200ms linear infinite;
    }

    .table-responsive {
        border: 1px solid #dee2e6 !important;
        margin-top: 20px;
        width: 100%;
        background-color: white;
    }

    .all_headers {
        width: 170px;
        overflow: hidden;
        white-space: nowrap;
    }

    .btn-danger {
        margin-left: 5px;
    }

    .modal-body {
        height: 70vh;
        overflow-y: auto;
    }

    tr:nth-child(even) {
        background-color: #e9ecef;
    }

    .all_headers_form {
        margin-left: 12px;
        padding: 5px;
    }

    .filter_bar {
        height: calc(100vh - 3.5rem);
        overflow-y: auto;
        background-color: white;
    }

</style>

@if (@mode is not null)
{
    <style>
        .flatpickr-prev-month, .flatpickr-month .numInputWrapper, .flatpickr-next-month {
            visibility: hidden;
        }

        .flatpickr-month {
            font-size: large;
        }
    </style>
}

@code {
    private long? selectedTreeRegion;
    private List<string> alertTypes = new();
    private string userLogin = string.Empty;
    static DateTime currentTime = DateTime.Now;
    private AlertMonitoringReportRequestModel filter = new AlertMonitoringReportRequestModel()
        {
            fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0),
            toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0)
        };

    [Parameter]
    public string? mode { get; set; }
    private List<int> archiveYears = new();
    bool isArchive = false;
    bool showSpinner = false;
    bool IsDisabled = false;

    private DotNetObjectReference<AlertMonitoringReport>? objRef;


    [Inject] INotificationService? NotificationService { get; set; }

    protected async override void OnParametersSet()
    {
        try
        {
            if (mode is not null && mode.Equals("Archive"))
            {
                archiveYears = common.GetLastNYears();
                filter.ArchiveYear = archiveYears.FirstOrDefault();
                filter.toDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
                filter.fromDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
                isArchive = true;
            }
            else
            {
                filter.fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
                filter.toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
                filter.ArchiveYear = 0;
            }
            filter.type = "*";
            filter.UserId = (await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser")).UserId;
            await this.InvokeAsync(() => this.StateHasChanged());
        }
        catch (Exception ex)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);

        alertTypes = await service.GetAlertTypes();
        userLogin = (await localStorage.GetItemAsync<EView360Models.Core.AppUser>("AppUser")).UserLogin;
        await this.InvokeAsync(() => this.StateHasChanged());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await jsRuntime.InvokeVoidAsync("handleDatePicker", objRef);
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AlertMonitoringReport, OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    private void ResetFilter()
    {
        currentTime = DateTime.Now;

        if (isArchive)
        {
            filter.ArchiveYear = archiveYears.FirstOrDefault();
            filter.fromDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
            filter.toDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
        }
        else
        {
            filter.fromDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 0, 0, 0);
            filter.toDate = new DateTime(currentTime.Year, currentTime.Month, currentTime.Day, 23, 59, 0);
            filter.ArchiveYear = 0;
        }
        filter.type = "*";
        this.InvokeAsync(() => this.StateHasChanged());
    }

    private Task OnArchiveYearChange(int selectedYear)
    {
        filter.ArchiveYear = selectedYear;
        filter.fromDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 0, 0, 0);
        filter.toDate = new DateTime(filter.ArchiveYear, currentTime.Month, currentTime.Day, 23, 59, 0);
        this.InvokeAsync(() => this.StateHasChanged());
        return Task.CompletedTask;
    }

    private Task ChangeToArchiveYear()
    {
        if (isArchive)
        {
            if (filter.fromDate != null && filter.fromDate.Value.Year != filter.ArchiveYear)
                filter.fromDate = new DateTime(filter.ArchiveYear, filter.fromDate.Value.Month, filter.fromDate.Value.Day, filter.fromDate.Value.Hour, filter.fromDate.Value.Month, filter.fromDate.Value.Second);

            if (filter.toDate != null && filter.toDate.Value.Year != filter.ArchiveYear)
                filter.toDate = new DateTime(filter.ArchiveYear, filter.toDate.Value.Month, filter.toDate.Value.Day, filter.toDate.Value.Hour, filter.toDate.Value.Month, filter.toDate.Value.Second);
        }
        return Task.CompletedTask;
    }

    private async void FilterSubmit()
    {
        showSpinner = IsDisabled = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

        logger.LogWarning($"[AlertMonitoringReportPage:FilterSubmit] going in GetAlertMonitoringReport ");
        var data = await alertService.GetAlertMonitoringReport(filter);
        logger.LogWarning($"[AlertMonitoringReportPage:FilterSubmit] returning from GetAlertMonitoringReport ");

        logger.LogWarning("[AlertMonitoringReportPage:FilterSubmit] Start Serializing Datatable ");
        string serializedDatatable = JsonConvert.SerializeObject(data);
        logger.LogWarning("[AlertMonitoringReportPage:FilterSubmit] End Serializing Datatable ");

        logger.LogWarning("[AlertMonitoringReportPage:FilterSubmit] Start convering serialized Datatable into bytes ");
        byte[] bytes = Encoding.ASCII.GetBytes(serializedDatatable);
        logger.LogWarning("[AlertMonitoringReportPage:FilterSubmit] End convering serialized Datatable into bytes ");

        string redisKey = $"AlertMonitoringReport_{filter.UserId}";
        _distributedCache.Set(redisKey, bytes);

        var reports = new ReportsRequestModel()
            {
                redisKey = $"{redisKey}",
            };


        if (data.Rows.Count > 0)
        {
            string url = $"{apiUrl.Value.ReportingProjectUrl}ReportPopup.aspx?Report=Alerts.rpt&ReportTitle=Alert%20Monitoring%20Report&FromDate={filter.fromDate.Value.Date.ToString("MM/dd/yyyy")}&ToDate={filter.toDate.Value.Date.ToString("MM/dd/yyyy")}&GeneratedBy={userLogin}";
            await jsRuntime.InvokeVoidAsync("openWindowWithPost", url, reports);
        }
        //}
        showSpinner = IsDisabled = false;
        await this.InvokeAsync(() => this.StateHasChanged());
    }
}