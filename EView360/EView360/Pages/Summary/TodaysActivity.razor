@code {
    public List<TodaysActivityViewModel> todaysActivity = new();
    private DataGrid<TodaysActivityViewModel>? dataGridRef;
    private bool showSpinner = false;
    private bool showGrid = false;
    [Inject]
    INotificationService NotificationService { get; set; }


    public async Task LoadData()
    {
        showSpinner = true;
        showGrid = false;
        await this.InvokeAsync(() => this.StateHasChanged());
        AppUser appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
        var requesModel = new TodaysActivityRequestModel()
            {

                UserId = appUser.UserId
            };
        todaysActivity = await todaysActivityService.GetTodaysActivity(requesModel);
        
        showSpinner = false;
        showGrid = true;
        await this.InvokeAsync(() => this.StateHasChanged());
        await common.TaskDelay();

    }
}
