@inject TodaysActivityService todaysActivityService
@inject ATMTreeViewRepository atmRepository
@inject CommonServices common
@inject Blazored.LocalStorage.ILocalStorageService localStorage


<div class="">
    @if (showSpinner)
    {
        <div class="spinner" style="z-index:4"></div>
    }

        <DataGrid @ref="@dataGridRef"
              TItem="TodaysActivityViewModel"
              Data="@todaysActivity"
                    Editable
              Responsive="true"
                    Bordered
              PageSize="1000000"
                    FixedHeader
              FixedHeaderDataGridHeight="280px"
              FixedHeaderDataGridMaxHeight="280px"
              Narrow="true"
                    Sortable  SortMode="DataGridSortMode.Single"
              HeaderThemeContrast="@ThemeContrast.Light">


        <DataGridColumn Field="@nameof(TodaysActivityViewModel.Status)" Caption="Status" />
        <DataGridColumn Field="@nameof(TodaysActivityViewModel.Count)" Caption="Count" />
        <DataGridColumn Field="@nameof(TodaysActivityViewModel.Task)" Caption="Task" />
        </DataGrid>
    
</div>


