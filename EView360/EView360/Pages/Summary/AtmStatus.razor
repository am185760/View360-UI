    {
        try
        {
            if (firstRender)
            {
                AppUser appUser = await localStorage.GetItemAsync<AppUser>("AppUser");
                if (appUser is not null)
                {
                    service.UserId = appUser.UserId;
                }

                // atmAlerts = await service.GetAtmAlertsAsync();

                //if (atmAlerts?.Count > 0)
                // {
                //faultyCounter = atmAlerts.Where(x => x.AlertTypeId == (int)EnumAlertType.ATMCassetteFaulty).Count();
                //inactivityCounter = atmAlerts.Where(x => x.AlertTypeId == (int)EnumAlertType.ATMInactivityPeriodElapsed || x.AlertTypeId == (int)EnumAlertType.ATMEJInactivityPeriodElapsed).Count();
                //dispensingFailed = atmAlerts.Where(x => x.AlertTypeId == (int)EnumAlertType.CassetteDispensingFailed).Count();

                //transactingCount = totalAtms - faultyCounter - inactivityCounter - dispensingFailed;

                //}

            }
        }
        catch (Exception ex)
        {
            logger.LogError($"Exception at AtmStatus summary, OnAfterRenderAsync as: {ex.Message}");

            await NotificationService.Error(ex.Message, "Error", (options) =>
            {
                options.IntervalBeforeClose = 4000;
            });
        }
    }

    public async Task LoadData()
    {
        pieChart = new();
        showChart = false;
        transactingCount = 0;
        trnxCountToday = 0;
        trnxCountYesterday = 0;
        this.InvokeAsync(() => this.StateHasChanged());

        await Task.Delay(5);

        var response = await service.GetTransactingATMTitle();

        if (response.isSucess)
        {
            transactingCount = response.atmTitles?.Count > 0 ? response.atmTitles.Count : 0;
            trnxCountToday = response.TrnxCountToday;
            trnxCountYesterday = response.TrnxCountYesterday;
        }
        totalAtms = service.totalAtms;
        noTransactingATM = totalAtms - transactingCount;

        showChart = true;
        this.InvokeAsync(() => this.StateHasChanged());
        await Task.Delay(100);


        await PieChartHandleRedraw(pieChart, transactingCount, noTransactingATM);
        await this.InvokeAsync(() => this.StateHasChanged());
    }


    private async Task PieChartHandleRedraw(PieChart<float> pieChart, int data1, int data2)
    {
        if (pieChart != null)
        {
            await pieChart.Clear();
            await pieChart.AddLabelsDatasetsAndUpdate(Labels, GetPieChartDataset(data1, data2));
        }
    }

    private PieChartDataset<float> GetPieChartDataset(int data1, int data2)
    {
        return new()
            {
                Data = new() { data1, data2 },
                BackgroundColor = backgroundColors,
                BorderColor = borderColors,
                BorderWidth = 1
            };
    }
}